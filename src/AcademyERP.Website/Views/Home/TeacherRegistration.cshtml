@{
    ViewData["Title"] = "Teacher Registration";
}

<section class="admission-page">
    <div class="container">

        <div class="admission-header">
            <span class="section-label">Teacher Registration</span>

            <h1>
                Join Our
                <span>Teaching Team</span>
            </h1>

            <p>
                Complete the form below with your personal details, qualifications,
                availability and current teaching assignments.
            </p>
        </div>

        <div class="admission-layout">

            <div class="admission-info-panel">
                <span class="admission-small-label">
                    MS INTERNATIONAL ACADEMY
                </span>

                <h2>Teacher Registration</h2>

                <p>
                    Your registration will be reviewed by our administration team.
                    If approved, you will receive your teacher account credentials.
                </p>
            </div>

            <div class="admission-form-card">

                <div class="admission-form-heading">
                    <span>TEACHER REGISTRATION FORM</span>
                    <h2>Personal Information</h2>
                </div>

                <form id="teacherRegistrationForm">

                    <div class="form-group">
                        <label>Full Name *</label>
                        <input type="text" id="FullName" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Date of Birth *</label>
                        <input type="date" id="DateOfBirth" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Gender *</label>
                        <select id="Gender" class="form-control" required>
                            <option value="">Select Gender</option>
                            <option value="1">Male</option>
                            <option value="2">Female</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>Mobile Number *</label>
                        <input type="tel" id="MobileNumber" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Email *</label>
                        <input type="email" id="Email" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Country *</label>
                        <input type="text" id="Country" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Address</label>
                        <textarea id="Address" class="form-control"></textarea>
                    </div>

                    <hr />

                    <div class="admission-form-heading">
                        <span>PROFESSIONAL DETAILS</span>
                        <h2>Qualification & Experience</h2>
                    </div>

                    <div class="form-group">
                        <label>Qualification *</label>
                        <input type="text" id="Qualification" class="form-control" required />
                    </div>

              <div class="form-group">
    <label>Department *</label>
    <select id="Department" class="form-control" required>
        <option value="">Select Program</option>
    </select>
</div>
                    <div class="form-group">
                        <label>Joining Date *</label>
                        <input type="date" id="JoiningDate" class="form-control" required />
                    </div>

                    <div class="form-group">
                        <label>Teaching Experience</label>
                        <textarea id="TeachingExperience"
                                  class="form-control"
                                  placeholder="Describe your teaching experience"></textarea>
                    </div>

                    <hr />

                    <div class="admission-form-heading">
                        <span>AVAILABILITY</span>
                        <h2>Teaching Availability</h2>
                    </div>

                    <p>
                        Select all days and time slots when you are available to teach.
                    </p>

                    <div id="availabilityContainer"></div>

                    <hr />

                    <div class="admission-form-heading">
                        <span>CURRENT CLASSES</span>
                        <h2>Current Teaching Assignments</h2>
                    </div>

                    <p>
                        If you are currently teaching Academy students, add their
                        existing class details below.
                    </p>

                    <div id="classesContainer"></div>

                    <button type="button"
                            id="addClassBtn"
                            class="btn btn-secondary mt-3">
                        + Add Current Class
                    </button>

                    <hr />

                    <div class="form-group">
                        <label>Additional Remarks</label>
                        <textarea id="Remarks"
                                  class="form-control"
                                  placeholder="Anything else you would like us to know"></textarea>
                    </div>

                    <div id="teacherRegistrationMessage"
                         class="mt-3"
                         style="display:none;">
                    </div>

                    <button type="submit"
                            id="submitTeacherRegistration"
                            class="btn admission-submit-btn mt-3">
                        Submit Teacher Registration
                    </button>

                </form>
            </div>
        </div>
    </div>
</section>

<script>

let teacherLookups = null;
let availabilityIndex = 0;
let classIndex = 0;

const days = [
    { value: 1, name: "Monday" },
    { value: 2, name: "Tuesday" },
    { value: 3, name: "Wednesday" },
    { value: 4, name: "Thursday" },
    { value: 5, name: "Friday" },
    { value: 6, name: "Saturday" },
    { value: 0, name: "Sunday" }
];

document.addEventListener("DOMContentLoaded", async () => {

    try {
        await loadTeacherLookups();

renderAvailability();
renderDepartments();

        document
            .getElementById("addClassBtn")
            .addEventListener("click", addCurrentClass);

        document
            .getElementById("teacherRegistrationForm")
            .addEventListener("submit", submitTeacherRegistration);

    } catch (error) {
        showMessage(
            "Unable to load registration data. Please try again later.",
            "alert alert-danger"
        );
    }
});

async function loadTeacherLookups() {

    const response = await fetch(
        `${window.academyApiBaseUrl}/api/teacher-registrations/lookups`
    );

    if (!response.ok) {
        throw new Error("Unable to load lookups.");
    }

    teacherLookups = await response.json();
}
function renderDepartments() {

    const departmentSelect =
        document.getElementById("Department");

    if (!teacherLookups.programs) {
        return;
    }

    departmentSelect.innerHTML = `
        <option value="">Select Department</option>
        ${
            teacherLookups.programs
                .map(x => `
                    <option value="${escapeHtml(x.programName)}">
                        ${escapeHtml(x.programName)}
                    </option>
                `)
                .join("")
        }
    `;
}
function renderAvailability() {

    const container =
        document.getElementById("availabilityContainer");

    const dayOptions = days
        .map(x => `
            <label class="d-flex align-items-center gap-2 mb-2">
                <input
                    type="checkbox"
                    class="availability-day"
                    value="${x.value}" />

                <span>${x.name}</span>
            </label>
        `)
        .join("");

    const slotOptions = teacherLookups.timeSlots
        .map(x => `
            <label class="d-flex align-items-center gap-2 mb-2 availability-slot-option">
                <input
                    type="checkbox"
                    class="availability-slot"
                    value="${x.id}" />

                <span>${escapeHtml(x.name)}</span>
            </label>
        `)
        .join("");

    container.innerHTML = `
        <div class="border rounded p-3 mb-3">

            <div class="form-group">
                <label class="mb-2">
                    Available Days *
                </label>

                <div class="availability-days-dropdown position-relative">

                    <button
                        type="button"
                        class="form-control text-start"
                        id="availabilityDaysToggle">
                        Select Teaching Days
                    </button>

                    <div
                        id="availabilityDaysMenu"
                        class="border rounded bg-white p-3 mt-1 shadow-sm"
                        style="display:none; position:absolute; z-index:1000; width:100%;">

                        ${dayOptions}

                    </div>

                </div>

                <small class="text-muted">
                    Select all days you are available to teach.
                </small>
            </div>

            <div class="mt-4">
                <label class="mb-2">
                    Available Time Slots *
                </label>

                <div class="border rounded p-3">
                    ${slotOptions}
                </div>

                <small class="text-muted">
                    The selected time slots will apply to all selected days.
                </small>
            </div>

        </div>
    `;

    const daysToggle =
        document.getElementById("availabilityDaysToggle");

    const daysMenu =
        document.getElementById("availabilityDaysMenu");

    daysToggle.addEventListener("click", function () {

        daysMenu.style.display =
            daysMenu.style.display === "none"
                ? "block"
                : "none";

    });

    const dayCheckboxes =
        daysMenu.querySelectorAll(".availability-day");

    dayCheckboxes.forEach(checkbox => {

        checkbox.addEventListener("change", function () {

            const selectedDays =
                [...dayCheckboxes]
                    .filter(x => x.checked)
                    .map(x => x.parentElement.querySelector("span").textContent.trim());

            if (selectedDays.length === 0) {

                daysToggle.textContent =
                    "Select Teaching Days";

            } else if (selectedDays.length <= 2) {

                daysToggle.textContent =
                    selectedDays.join(", ");

            } else {

                daysToggle.textContent =
                    `${selectedDays.length} days selected`;

            }

        });

    });

    document.addEventListener("click", function closeDaysDropdown(event) {

        if (!event.target.closest(".availability-days-dropdown")) {

            daysMenu.style.display = "none";

        }

    });

}

function addCurrentClass() {

    const container =
        document.getElementById("classesContainer");

    const card = document.createElement("div");

    card.className = "border rounded p-3 mb-3 current-class-row";

    const studentOptions = teacherLookups.students.length > 0
    ? teacherLookups.students
        .map(x => `
            <option value="${x.id}">
                ${escapeHtml(x.fullName)}
                ${x.admissionNumber
                    ? `(${escapeHtml(x.admissionNumber)})`
                    : ""}
            </option>
        `)
        .join("")
    : `<option value="" disabled>No existing students available</option>`;

    const courseOptions = teacherLookups.courses
        .map(x => `
            <option value="${x.id}">
                ${escapeHtml(x.courseName)} (${escapeHtml(x.courseCode)})
            </option>
        `)
        .join("");

    const dayOptions = days
        .map(x => `
            <label class="d-flex align-items-center gap-2 mb-2">
                <input
                    type="checkbox"
                    class="current-day"
                    value="${x.value}" />
                <span>${x.name}</span>
            </label>
        `)
        .join("");

    const slotOptions = teacherLookups.timeSlots
        .map(x => `
            <label class="d-flex align-items-center gap-2 mb-2">
                <input
                    type="checkbox"
                    class="current-slot"
                    value="${x.id}" />
                <span>${escapeHtml(x.name)}</span>
            </label>
        `)
        .join("");

    const durationOptions = teacherLookups.classDurations
        .map(x => `
            <option value="${x.id}">
                ${escapeHtml(x.name)}
            </option>
        `)
        .join("");

    card.innerHTML = `
       <div class="form-group">
    <label>Student</label>

    <select class="form-control current-student">
        <option value="">Select Existing Student</option>
        ${studentOptions}
    </select>

    <small class="text-muted d-block mt-1">
        If the student is not listed, enter the name below.
    </small>

    <input
        type="text"
        class="form-control current-student-name mt-2"
        placeholder="Or enter student name manually" />
</div>

        <div class="form-group">
            <label>Course *</label>
            <select class="form-control current-course" required>
                <option value="">Select Course</option>
                ${courseOptions}
            </select>
        </div>

        <div class="mt-3">
            <label class="mb-2">Days *</label>

            <div class="border rounded p-3">
                ${dayOptions}
            </div>
        </div>

        <div class="mt-3">
            <label class="mb-2">Time Slots *</label>

            <div class="border rounded p-3">
                ${slotOptions}
            </div>
        </div>

        <div class="form-group mt-3">
            <label>Class Duration *</label>

            <select class="form-control current-duration" required>
                <option value="">Select Duration</option>
                ${durationOptions}
            </select>
        </div>

        <div class="form-group">
            <label>Class Type</label>

            <select class="form-control current-class-type">
                <option value="">Select Class Type</option>
                <option value="Individual">Individual</option>
                <option value="Group">Group</option>
            </select>
        </div>

        <button
            type="button"
            class="btn btn-outline-danger mt-3 remove-class">
            Remove Class
        </button>
    `;

    card.querySelector(".remove-class")
        .addEventListener("click", () => card.remove());

    container.appendChild(card);
}

async function submitTeacherRegistration(event) {

    event.preventDefault();

    const submitButton =
        document.getElementById("submitTeacherRegistration");

    submitButton.disabled = true;
    submitButton.textContent = "Submitting...";

    try {

    const availability = [];

const selectedDays =
    [...document.querySelectorAll(".availability-day:checked")]
        .map(x => Number(x.value));

const selectedSlots =
    [...document.querySelectorAll(".availability-slot:checked")]
        .map(x => x.value);

if (selectedDays.length === 0) {
    throw new Error(
        "Please select at least one teaching day."
    );
}

if (selectedSlots.length === 0) {
    throw new Error(
        "Please select at least one teaching time slot."
    );
}

selectedDays.forEach(day => {

    selectedSlots.forEach(timeSlotId => {

        availability.push({
            dayOfWeek: day,
            timeSlotId: timeSlotId
        });

    });

});

        const currentClasses = [];

document
    .querySelectorAll(".current-class-row")
    .forEach(row => {

        const studentId =
    row.querySelector(".current-student").value || null;

const studentName =
    row.querySelector(".current-student-name").value.trim() || null;

        const courseId =
            row.querySelector(".current-course").value;

        const classDurationId =
            row.querySelector(".current-duration").value;

        const classType =
            row.querySelector(".current-class-type").value || null;

        const selectedDays =
            [...row.querySelectorAll(".current-day:checked")]
                .map(x => Number(x.value));

        const selectedSlots =
            [...row.querySelectorAll(".current-slot:checked")]
                .map(x => x.value);

        selectedDays.forEach(day => {

            selectedSlots.forEach(timeSlotId => {

                currentClasses.push({
    studentId,
    studentName,
    courseId,
    dayOfWeek: day,
    timeSlotId,
    classDurationId,
    classType
});

            });

        });

    });
    if (currentClasses.length > 0) {

    const invalidClass =
        [...document.querySelectorAll(".current-class-row")]
            .some(row =>
    (
        !row.querySelector(".current-student").value &&
        !row.querySelector(".current-student-name").value.trim()
    ) ||
    !row.querySelector(".current-course").value ||
                row.querySelectorAll(".current-day:checked").length === 0 ||
                row.querySelectorAll(".current-slot:checked").length === 0 ||
                !row.querySelector(".current-duration").value
            );

    if (invalidClass) {
        throw new Error(
            "Please select a student, course, at least one day, at least one time slot and class duration for each current class."
        );
    }
}

        const payload = {
            fullName:
                document.getElementById("FullName").value.trim(),

            dateOfBirth:
                document.getElementById("DateOfBirth").value,

            gender:
                Number(document.getElementById("Gender").value),

            mobileNumber:
                document.getElementById("MobileNumber").value.trim(),

            email:
                document.getElementById("Email").value.trim(),

            country:
                document.getElementById("Country").value.trim(),

            address:
                document.getElementById("Address").value.trim() || null,

            qualification:
                document.getElementById("Qualification").value.trim(),

            department:
                document.getElementById("Department").value.trim(),

            joiningDate:
                document.getElementById("JoiningDate").value,

            teachingExperience:
                document.getElementById("TeachingExperience").value.trim() || null,

            remarks:
                document.getElementById("Remarks").value.trim() || null,

            availability,
            currentClasses
        };

        const response = await fetch(
            `${window.academyApiBaseUrl}/api/teacher-registrations`,
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(payload)
            }
        );

        if (!response.ok) {

            let message =
                "Unable to submit registration.";

            try {
                const result = await response.json();

                if (result.message) {
                    message = result.message;
                }

                if (result.errors) {
                    message =
                        Object.values(result.errors)
                            .flat()
                            .join(" ");
                }

            } catch { }

            throw new Error(message);
        }

        showMessage(
            "Registration submitted successfully. Our administration team will review your application.",
            "alert alert-success"
        );

        document
            .getElementById("teacherRegistrationForm")
            .reset();

        document.getElementById("availabilityContainer").innerHTML = "";
document.getElementById("classesContainer").innerHTML = "";

renderAvailability();
renderDepartments();

    } catch (error) {

        showMessage(
            error.message ||
            "Something went wrong while submitting your registration.",
            "alert alert-danger"
        );

    } finally {

        submitButton.disabled = false;
        submitButton.textContent = "Submit Teacher Registration";
    }
}

function showMessage(message, cssClass) {

    const element =
        document.getElementById("teacherRegistrationMessage");

    element.className = `mt-3 ${cssClass}`;
    element.textContent = message;
    element.style.display = "block";

    element.scrollIntoView({
        behavior: "smooth",
        block: "center"
    });
}

function escapeHtml(value) {

    return String(value ?? "")
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
}

</script>
