<AuthorizeView Roles="@Roles.Teacher">

    <MudNavLink Href="/Teachers/TeacherDashboard"
                Icon="@Icons.Material.Filled.Person">
        Teacher Dashboard
    </MudNavLink>

</AuthorizeView>
@code
{
    private int _newAdmissions;
    private int _newRegistrations;

   protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender)
        return;

    await LoadNotificationCounts();
    StateHasChanged();
}
    private async Task LoadNotificationCounts()
{
    try
    {
        var summary = await DashboardApi.GetSummaryAsync();

        if (summary != null)
        {
            _newAdmissions = summary.NewAdmissions;
            _newRegistrations = summary.NewRegistrations;
        }
    }
    catch (HttpRequestException)
    {
        _newAdmissions = 0;
        _newRegistrations = 0;
    }
    catch (InvalidOperationException)
    {
        _newAdmissions = 0;
        _newRegistrations = 0;
    }
}
}
</MudNavMenu>
