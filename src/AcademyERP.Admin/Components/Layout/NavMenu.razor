@using Microsoft.AspNetCore.Components.Authorization
@using AcademyERP.Admin.Constants

<MudNavMenu>

    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    <AuthorizeView Roles="@($"{Roles.SuperAdmin},{Roles.Administrator}")">

        <MudNavLink Href="/students" Icon="@Icons.Material.Filled.People">
            Students
        </MudNavLink>

        <MudNavLink Href="/teachers" Icon="@Icons.Material.Filled.Person">
            Teachers
        </MudNavLink>
        <MudNavLink Href="/teachingschedules" Icon="@Icons.Material.Filled.Schedule">

