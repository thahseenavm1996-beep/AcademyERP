        </MudNavLink>
        <MudNavLink Href="/parents" Icon="@Icons.Material.Filled.Groups">
            Parents
        </MudNavLink>
        <MudNavLink Href="/programs" Icon="@Icons.Material.Filled.School">

            Programs

        </MudNavLink>

        <MudNavLink Href="/courses" Icon="@Icons.Material.Filled.MenuBook">
            Courses
        </MudNavLink>

        <MudNavLink Href="/enrollments" Icon="@Icons.Material.Filled.Assignment">
            Enrollments
        </MudNavLink>

        <MudNavLink Href="/fees" Icon="@Icons.Material.Filled.Payments">
            Fees
        </MudNavLink>

        <MudNavLink Href="/reports" Icon="@Icons.Material.Filled.Analytics">
            Reports
        </MudNavLink>

    </AuthorizeView>

