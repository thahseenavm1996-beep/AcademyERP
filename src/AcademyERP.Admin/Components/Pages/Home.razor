    private void OpenMostEnrolledProgram()
{
    var program = Summary?.ProgramPerformance?
        .OrderByDescending(x => x.EnrollmentCount)
        .FirstOrDefault();

    if (program is null)
        return;

    Navigation.NavigateTo($"/programs?programId={program.ProgramId}");
}

