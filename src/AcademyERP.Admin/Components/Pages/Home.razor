@page "/"

@inject DashboardApiService DashboardApi
@inject CommunicationApiService CommunicationApi
@inject NavigationManager Navigation

@using Microsoft.AspNetCore.Components.Authorization
@using AcademyERP.Admin.Models
@using AcademyERP.Admin.Models.Communication
@using AcademyERP.Admin.Services
@using MudBlazor

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">

    <!-- Header -->
    <div class="d-flex justify-space-between align-center mb-6 flex-wrap gap-3">

        <div>
            <MudText Typo="Typo.h4" Class="fw-bold">
                Dashboard
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Academy overview and quick access
            </MudText>
        </div>

        <AuthorizeView>
            <Authorized>
                <MudChip T="string"
                         Color="Color.Primary"
                         Variant="Variant.Outlined"
                         Icon="@Icons.Material.Filled.AccountCircle">
                    Welcome, @context.User.Identity?.Name
                </MudChip>
            </Authorized>
        </AuthorizeView>

    </div>


    <!-- Main Statistics -->
    <MudGrid Class="mb-5">
<MudItem xs="12" sm="6" md="6">
    <MudPaper Class="dashboard-stat-card pa-5"
              Elevation="2"
              Style="cursor:pointer"
              @onclick="OpenAdmissions">

        <div class="d-flex justify-space-between align-start">
            <div>
                <MudText Typo="Typo.subtitle2"
                         Color="Color.Secondary">
                    New Admissions
                </MudText>

                <MudText Typo="Typo.h3"
                         Color="Color.Error"
                         Class="fw-bold mt-2">
                    @(Summary?.NewAdmissions ?? 0)
                </MudText>

                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">
                    Admissions not yet viewed
                </MudText>
            </div>

            <MudIcon Icon="@Icons.Material.Filled.PersonAdd"
                     Color="Color.Primary"
                     Size="Size.Large" />
        </div>

    </MudPaper>
</MudItem>

<MudItem xs="12" sm="6" md="6">
    <MudPaper Class="dashboard-stat-card pa-5"
              Elevation="2"
              Style="cursor:pointer"
              @onclick="OpenRegistrations">

        <div class="d-flex justify-space-between align-start">
            <div>
                <MudText Typo="Typo.subtitle2"
                         Color="Color.Secondary">
                    New Registrations
                </MudText>

                <MudText Typo="Typo.h3"
                         Color="Color.Error"
                         Class="fw-bold mt-2">
                    @(Summary?.NewRegistrations ?? 0)
                </MudText>

                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">
                    Registrations not yet viewed
                </MudText>
            </div>

            <MudIcon Icon="@Icons.Material.Filled.Approval"
                     Color="Color.Primary"
                     Size="Size.Large" />
        </div>

    </MudPaper>
</MudItem>
        <MudItem xs="12" sm="6" md="6" lg="3">
            <MudPaper Class="dashboard-stat-card pa-5"
                      Elevation="2" Style="cursor:pointer" @onclick="OpenStudents">

                <div class="d-flex justify-space-between align-start">

                    <div>
                        <MudText Typo="Typo.subtitle2"
                                 Color="Color.Secondary">
                            Total Students
                        </MudText>

                        <MudText Typo="Typo.h3"
                                 Color="Color.Primary"
                                 Class="fw-bold mt-2">
                            @(Summary?.TotalStudents ?? 0)
                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">
                            Registered students
                        </MudText>
                    </div>

                    <MudIcon Icon="@Icons.Material.Filled.School"
                             Color="Color.Primary"
                             Size="Size.Large" />

                </div>

            </MudPaper>
        </MudItem>


        <MudItem xs="12" sm="6" md="6" lg="3">
            <MudPaper Class="dashboard-stat-card pa-5"
                      Elevation="2" Style="cursor:pointer" @onclick="OpenParents">

                <div class="d-flex justify-space-between align-start">

                    <div>
                        <MudText Typo="Typo.subtitle2"
                                 Color="Color.Secondary">
                            Total Parents
                        </MudText>

                        <MudText Typo="Typo.h3"
                                 Color="Color.Success"
                                 Class="fw-bold mt-2">
                            @(Summary?.TotalParents ?? 0)
                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">
                            Registered parents
                        </MudText>
                    </div>

                    <MudIcon Icon="@Icons.Material.Filled.FamilyRestroom"
                             Color="Color.Success"
                             Size="Size.Large" />

                </div>

            </MudPaper>
        </MudItem>


        <MudItem xs="12" sm="6" md="6" lg="3">
            <MudPaper Class="dashboard-stat-card pa-5"
                      Elevation="2" Style="cursor:pointer" @onclick="OpenTeachers">

                <div class="d-flex justify-space-between align-start">

                    <div>
                        <MudText Typo="Typo.subtitle2"
                                 Color="Color.Secondary">
                            Total Teachers
                        </MudText>

                        <MudText Typo="Typo.h3"
                                 Color="Color.Warning"
                                 Class="fw-bold mt-2">
                            @(Summary?.TotalTeachers ?? 0)
                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">
                            Teaching staff
                        </MudText>
                    </div>

                    <MudIcon Icon="@Icons.Material.Filled.Person"
                             Color="Color.Warning"
                             Size="Size.Large" />

                </div>

            </MudPaper>
        </MudItem>


        <MudItem xs="12" sm="6" md="6" lg="3">
            <MudPaper Class="dashboard-stat-card pa-5"
                      Elevation="2" Style="cursor:pointer" @onclick="OpenPrograms">

                <div class="d-flex justify-space-between align-start">

                    <div>
                        <MudText Typo="Typo.subtitle2"
                                 Color="Color.Secondary">
                            Programs
                        </MudText>

                        <MudText Typo="Typo.h3"
                                 Color="Color.Error"
                                 Class="fw-bold mt-2">
                            @(Summary?.TotalPrograms ?? 0)
                        </MudText>

                        <MudText Typo="Typo.caption"
                                 Color="Color.Secondary">
                            Academic programs
                        </MudText>
                    </div>

                    <MudIcon Icon="@Icons.Material.Filled.MenuBook"
                             Color="Color.Error"
                             Size="Size.Large" />

                </div>

            </MudPaper>
        </MudItem>

    </MudGrid>


    <!-- Operational Statistics -->
    <MudGrid Class="mb-5">

        <MudItem xs="12" md="4">
           <MudPaper Class="dashboard-secondary-card pa-5"
          Elevation="1"
          Style="cursor:pointer;"
          @onclick="OpenStudents">

                <MudText Typo="Typo.subtitle2"
                         Color="Color.Secondary">
                    Active Students
                </MudText>

                <div class="d-flex align-center mt-2">
                    <MudText Typo="Typo.h4" Class="fw-bold">
                        @(Summary?.ActiveStudents ?? 0)
                    </MudText>

                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp"
                             Color="Color.Success"
                             Class="ms-3" />
                </div>

                <MudProgressLinear Class="mt-3"
                                   Color="Color.Primary"
                                   Value="@GetStudentActivityPercentage()" />

            </MudPaper>
        </MudItem>


        <MudItem xs="12" md="4">
            <MudPaper Class="dashboard-secondary-card pa-5"
          Elevation="1"
          Style="cursor:pointer;"
          @onclick="OpenTeachers">

                <MudText Typo="Typo.subtitle2"
                         Color="Color.Secondary">
                    Active Teachers
                </MudText>

                <div class="d-flex align-center mt-2">
                    <MudText Typo="Typo.h4" Class="fw-bold">
                        @(Summary?.ActiveTeachers ?? 0)
                    </MudText>

                    <MudIcon Icon="@Icons.Material.Filled.VerifiedUser"
                             Color="Color.Success"
                             Class="ms-3" />
                </div>

                <MudProgressLinear Class="mt-3"
                                   Color="Color.Success"
                                   Value="@GetTeacherActivityPercentage()" />

            </MudPaper>
        </MudItem>


        <MudItem xs="12" md="4">
           <MudPaper Class="dashboard-secondary-card pa-5"
          Elevation="1"
          Style="cursor:pointer;"
          @onclick="OpenPrograms">

                <MudText Typo="Typo.subtitle2"
                         Color="Color.Secondary">
                    Running Programs
                </MudText>

                <div class="d-flex align-center mt-2">
                    <MudText Typo="Typo.h4" Class="fw-bold">
                        @(Summary?.TotalPrograms ?? 0)
                    </MudText>

                    <MudIcon Icon="@Icons.Material.Filled.PlayCircle"
                             Color="Color.Warning"
                             Class="ms-3" />
                </div>

                <MudText Typo="Typo.caption"
                         Color="Color.Secondary">
                    Currently available programs
                </MudText>

            </MudPaper>
        </MudItem>

    </MudGrid>


<!-- Financial Overview -->
<MudText Typo="Typo.h6"
         Class="fw-bold mb-3">
    Financial Overview
</MudText>

<MudGrid Class="mb-5">

    <!-- Total Collected -->
    <MudItem xs="12" sm="6" md="6" lg="3">
        <MudPaper Class="dashboard-finance-card pa-5"
                  Elevation="2" Style="cursor:pointer" @onclick="OpenFees">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Total Collected
                    </MudText>

                    <MudText Typo="Typo.h5"
                             Color="Color.Success"
                             Class="fw-bold mt-2">
                        @FormatCurrency(Summary?.TotalCollected ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Payments received
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet"
                         Color="Color.Success"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Pending Fees -->
    <MudItem xs="12" sm="6" md="6" lg="3">
        <MudPaper Class="dashboard-finance-card pa-5"
                  Elevation="2" Style="cursor:pointer" @onclick="OpenFees">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Pending Fees
                    </MudText>

                    <MudText Typo="Typo.h5"
                             Color="Color.Warning"
                             Class="fw-bold mt-2">
                        @FormatCurrency(Summary?.PendingFees ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Outstanding balance
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.PendingActions"
                         Color="Color.Warning"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Total Invoiced -->
    <MudItem xs="12" sm="6" md="6" lg="3">
        <MudPaper Class="dashboard-finance-card pa-5"
                  Elevation="2" Style="cursor:pointer" @onclick="OpenFees">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Total Invoiced
                    </MudText>

                    <MudText Typo="Typo.h5"
                             Color="Color.Primary"
                             Class="fw-bold mt-2">
                        @FormatCurrency(Summary?.TotalInvoiced ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Generated invoices
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.ReceiptLong"
                         Color="Color.Primary"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Overdue Fees -->
    <MudItem xs="12" sm="6" md="6" lg="3">
        <MudPaper Class="dashboard-finance-card pa-5"
                  Elevation="2" Style="cursor:pointer" @onclick="OpenFees">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Overdue Fees
                    </MudText>

                    <MudText Typo="Typo.h5"
                             Color="Color.Error"
                             Class="fw-bold mt-2">
                        @FormatCurrency(Summary?.OverdueFees ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Past due date
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.WarningAmber"
                         Color="Color.Error"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>

</MudGrid>


<!-- Today's Overview -->
<MudText Typo="Typo.h6"
         Class="fw-bold mb-3">
    Today's Overview
</MudText>

<MudGrid Class="mb-5">

    <!-- Today's Classes -->
    <MudItem xs="12" sm="6" md="4">
       <MudPaper Class="dashboard-today-card pa-5"
          Elevation="2"
          Style="cursor:pointer;"
          @onclick="OpenTodayClasses">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Today's Classes
                    </MudText>

                    <MudText Typo="Typo.h4"
                             Color="Color.Primary"
                             Class="fw-bold mt-2">
                        @(Summary?.TodayClasses ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Scheduled for today
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.Event"
                         Color="Color.Primary"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Completed -->
    <MudItem xs="12" sm="6" md="4">
       <MudPaper Class="dashboard-today-card pa-5"
          Elevation="2"
          Style="cursor:pointer;"
          @onclick="OpenCompletedClasses">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Completed Today
                    </MudText>

                    <MudText Typo="Typo.h4"
                             Color="Color.Success"
                             Class="fw-bold mt-2">
                        @(Summary?.TodayCompletedClasses ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Classes completed
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.TaskAlt"
                         Color="Color.Success"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Upcoming -->
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="dashboard-today-card pa-5"
          Elevation="2"
          Style="cursor:pointer;"
         @onclick="OpenUpcomingClasses">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Upcoming Today
                    </MudText>

                    <MudText Typo="Typo.h4"
                             Color="Color.Warning"
                             Class="fw-bold mt-2">
                        @(Summary?.TodayUpcomingClasses ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Not started yet
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.Schedule"
                         Color="Color.Warning"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Missed -->
    <MudItem xs="12" sm="6" md="4">
       <MudPaper Class="dashboard-today-card pa-5"
          Elevation="2"
          Style="cursor:pointer;"
          @onclick="OpenMissedClasses">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Missed Today
                    </MudText>

                    <MudText Typo="Typo.h4"
                             Color="Color.Error"
                             Class="fw-bold mt-2">
                        @(Summary?.TodayMissedClasses ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Student absences
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.EventBusy"
                         Color="Color.Error"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Teachers -->
    <MudItem xs="12" sm="6" md="4">
        <MudPaper Class="dashboard-today-card pa-5"
          Elevation="2"
          Style="cursor:pointer;"
          @onclick="ToggleTodayTeachers">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Teachers Today
                    </MudText>

                    <MudText Typo="Typo.h4"
                             Color="Color.Info"
                             Class="fw-bold mt-2">
                        @(Summary?.TodayTeachers ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Teachers with classes
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.SupervisorAccount"
                         Color="Color.Info"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Students -->
    <MudItem xs="12" sm="6" md="4">
       <MudPaper Class="dashboard-today-card pa-5"
          Elevation="2"
          Style="cursor:pointer;"
          @onclick="ToggleTodayStudents">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Students Today
                    </MudText>

                    <MudText Typo="Typo.h4"
                             Color="Color.Secondary"
                             Class="fw-bold mt-2">
                        @(Summary?.TodayStudents ?? 0)
                    </MudText>

                    <MudText Typo="Typo.caption"
                             Color="Color.Secondary">
                        Students with classes
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.Groups"
                         Color="Color.Secondary"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>

</MudGrid>
@if (_dashboardDetail == "teachers")
{
    <MudPaper Class="pa-5 mb-5" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-4">
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">
                    Teachers With Classes Today
                </MudText>

                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Only teachers assigned to today's scheduled classes
                </MudText>
            </div>

            <MudChip T="string"
                     Color="Color.Primary"
                     Variant="Variant.Outlined">
                @Summary.TodayTeacherList.Count teachers
            </MudChip>
        </div>

        <MudTable Items="Summary.TodayTeacherList"
                  Hover="true"
                  Dense="true"
                  Striped="true">

            <HeaderContent>
                <MudTh>Employee Code</MudTh>
                <MudTh>Teacher Name</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Employee Code">
                    @context.EmployeeCode
                </MudTd>

                <MudTd DataLabel="Teacher Name">
                    <MudText Class="fw-bold">
                        @context.FullName
                    </MudText>
                </MudTd>
            </RowTemplate>

        </MudTable>
    </MudPaper>
}

@if (_dashboardDetail == "students")
{
    <MudPaper Class="pa-5 mb-5" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-4">
            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">
                    Students With Classes Today
                </MudText>

                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Only students who have a scheduled class today
                </MudText>
            </div>

            <MudChip T="string"
                     Color="Color.Primary"
                     Variant="Variant.Outlined">
                @Summary.TodayStudentList.Count students
            </MudChip>
        </div>

        <MudTable Items="Summary.TodayStudentList"
                  Hover="true"
                  Dense="true"
                  Striped="true">

            <HeaderContent>
                <MudTh>Admission No</MudTh>
                <MudTh>Student Name</MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd DataLabel="Admission No">
                    @context.AdmissionNumber
                </MudTd>

                <MudTd DataLabel="Student Name">
                    <MudText Class="fw-bold">
                        @context.FullName
                    </MudText>
                </MudTd>
            </RowTemplate>

        </MudTable>
    </MudPaper>
}
<!-- Program Performance -->

<MudText Typo="Typo.h6"
         Class="fw-bold mb-3">
    Program Performance
</MudText>

<MudGrid Class="mb-5">

    <!-- Most Enrolled Program -->
    <MudItem xs="12" md="4">
       <MudPaper Class="dashboard-performance-highlight pa-5"
          Elevation="2"
          Style="cursor:pointer;"
          @onclick="ToggleMostEnrolledProgram">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Most Enrolled
                    </MudText>

                    <MudText Typo="Typo.h6"
                             Color="Color.Primary"
                             Class="fw-bold mt-2">
                        @GetMostEnrolledProgramName()
                    </MudText>

                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary"
                             Class="mt-1">
                        @GetMostEnrolledCount() enrollments
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.Groups"
                         Color="Color.Primary"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Best Attendance Program -->
    <MudItem xs="12" md="4">
        <MudPaper Class="dashboard-performance-highlight pa-5"
                  Elevation="2">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Best Attendance
                    </MudText>

                    <MudText Typo="Typo.h6"
                             Color="Color.Success"
                             Class="fw-bold mt-2">
                        @GetBestAttendanceProgramName()
                    </MudText>

                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary"
                             Class="mt-1">
                        @GetBestAttendancePercentage().ToString("0.##")% attendance
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.EventAvailable"
                         Color="Color.Success"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>


    <!-- Best Performing Program -->
    <MudItem xs="12" md="4">
        <MudPaper Class="dashboard-performance-highlight pa-5"
                  Elevation="2">

            <div class="d-flex justify-space-between align-start">

                <div>
                    <MudText Typo="Typo.subtitle2"
                             Color="Color.Secondary">
                        Best Performing
                    </MudText>

                    <MudText Typo="Typo.h6"
                             Color="Color.Warning"
                             Class="fw-bold mt-2">
                        @GetBestPerformingProgramName()
                    </MudText>

                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary"
                             Class="mt-1">
                        @GetBestPerformanceScore().ToString("0.##") / 5
                    </MudText>
                </div>

                <MudIcon Icon="@Icons.Material.Filled.Star"
                         Color="Color.Warning"
                         Size="Size.Large" />

            </div>

        </MudPaper>
    </MudItem>
@if (_dashboardDetail == "program")
{
    <MudPaper Class="pa-5 mb-5" Elevation="1">

        <div class="d-flex justify-space-between align-center mb-4">

            <div>
                <MudText Typo="Typo.h6" Class="fw-bold">
                    @GetMostEnrolledProgramName() — Enrollments
                </MudText>

                <MudText Typo="Typo.body2"
                         Color="Color.Secondary">
                    Students enrolled in the most enrolled program
                </MudText>
            </div>

            <MudChip T="string"
