@code
{
    private DashboardSummaryResponse? Summary;

    private int UnreadMessageCount;

    private List<ConversationDto> RecentConversations = new();
    protected override async Task OnAfterRenderAsync(bool firstRender)
{
    if (!firstRender)
        return;

    try
    {
        Summary = await DashboardApi.GetSummaryAsync();

        UnreadMessageCount =
            await CommunicationApi.GetAdminUnreadMessageCountAsync();

        RecentConversations =
            (await CommunicationApi.GetAdminConversationsAsync())
            .OrderByDescending(x => x.LastMessageAt)
            .Take(3)
            .ToList();

        StateHasChanged();
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Dashboard loading failed: {ex.Message}");
    }
}
    private double GetStudentActivityPercentage()
    {
        if (Summary is null || Summary.TotalStudents == 0)
            return 0;

        return Math.Clamp(
            (double)Summary.ActiveStudents / Summary.TotalStudents * 100,
            0,
            100);
    }

    private double GetTeacherActivityPercentage()
    {
        if (Summary is null || Summary.TotalTeachers == 0)
            return 0;

        return Math.Clamp(
            (double)Summary.ActiveTeachers / Summary.TotalTeachers * 100,
            0,
            100);
    }

    private static string FormatCurrency(decimal amount)
{
    return $"₹{amount:N2}";
}

private static string GetActivityIcon(string activityType)
{
    return activityType switch
    {
        "Student" =>
            Icons.Material.Filled.PersonAdd,
            "Registration" =>
    Icons.Material.Filled.Approval,

        "Enrollment" =>
            Icons.Material.Filled.Assignment,

        "Invoice" =>
            Icons.Material.Filled.ReceiptLong,

        "Payment" =>
            Icons.Material.Filled.Payments,

        "Class" =>
            Icons.Material.Filled.Event,

        "Missed" =>
            Icons.Material.Filled.EventBusy,

        _ =>
            Icons.Material.Filled.History
    };
}

private static Color GetActivityColor(string activityType)
{
    return activityType switch
    {
        "Student" => Color.Primary,
         "Registration" => Color.Secondary,
        "Enrollment" => Color.Info,
        "Invoice" => Color.Warning,
        "Payment" => Color.Success,
        "Class" => Color.Secondary,
        "Missed" => Color.Error,
        _ => Color.Default
    };
}

private string GetMostEnrolledProgramName()
{
    return Summary?.ProgramPerformance?
        .OrderByDescending(x => x.EnrollmentCount)
        .FirstOrDefault()?
        .ProgramName
        ?? "No data";
}

private int GetMostEnrolledCount()
{
    return Summary?.ProgramPerformance?
        .OrderByDescending(x => x.EnrollmentCount)
        .FirstOrDefault()?
        .EnrollmentCount
        ?? 0;
}

private string GetBestAttendanceProgramName()
{
    return Summary?.ProgramPerformance?
        .Where(x => x.AttendanceCount > 0)
        .OrderByDescending(x => x.AttendancePercentage)
        .FirstOrDefault()?
        .ProgramName
        ?? "No data";
}

private decimal GetBestAttendancePercentage()
{
    return Summary?.ProgramPerformance?
        .Where(x => x.AttendanceCount > 0)
        .OrderByDescending(x => x.AttendancePercentage)
        .FirstOrDefault()?
        .AttendancePercentage
        ?? 0m;
}

private string GetBestPerformingProgramName()
{
    return Summary?.ProgramPerformance?
        .Where(x => x.PerformanceReportCount >= 3)
        .OrderByDescending(x => x.AveragePerformance)
        .FirstOrDefault()?
        .ProgramName
        ?? "No data";
}

private decimal GetBestPerformanceScore()
{
    return Summary?.ProgramPerformance?
        .Where(x => x.PerformanceReportCount >= 3)
        .OrderByDescending(x => x.AveragePerformance)
        .FirstOrDefault()?
        .AveragePerformance
        ?? 0m;
}

private double GetPerformancePercentage(decimal performance)
{
    return Math.Clamp(
        (double)(performance / 5m * 100m),
        0,
        100);
}

