@using AcademyERP.Admin.Models
@using AcademyERP.Admin.Services
@using Microsoft.AspNetCore.Components
@inject ParentApiService ParentApi
@inject NavigationManager Navigation

<MudDialog>
    <DialogContent>

        @if (_loading)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Indeterminate="true"
                                     Color="Color.Primary" />
            </div>
        }
        else
        {
            <MudText Typo="Typo.h5" Class="mb-4">
                @_parent.FullName
            </MudText>

            <MudGrid Spacing="3">

                <MudItem xs="12" sm="6">
                    <MudText>
                        <b>Phone:</b>
                        @(string.IsNullOrWhiteSpace(_parent.PhoneNumber)
                            ? "-"
                            : _parent.PhoneNumber)
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText>
                        <b>Email:</b>
                        @(string.IsNullOrWhiteSpace(_parent.Email)
                            ? "-"
                            : _parent.Email)
                    </MudText>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudText>
                        <b>Status:</b> @_parent.Status
                    </MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudText>
                        <b>Remarks:</b> @(_parent.Remarks ?? "-")
                    </MudText>
                </MudItem>

            </MudGrid>

            <MudDivider Class="my-5" />

            <!-- Children -->
            <MudText Typo="Typo.h6" Class="mb-3">
                <MudIcon Icon="@Icons.Material.Filled.Groups"
                         Class="mr-2" />
                Students / Children
                <MudChip T="string"
                         Size="Size.Small"
                         Color="Color.Primary"
                         Class="ml-2">
                    @_parent.ChildrenCount
                </MudChip>
            </MudText>

            @if (_parent.Children?.Any() == true)
            {
                <MudTable Items="_parent.Children"
                          Hover="true"
                          Dense="true"
                          Bordered="true">

                    <HeaderContent>
                        <MudTh>Student</MudTh>
                        <MudTh>Admission No.</MudTh>
                        <MudTh>Gender</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>

                    <RowTemplate>
                        <MudTd DataLabel="Student">
                            <MudText Typo="Typo.body2">
                                <b>@context.FullName</b>
                            </MudText>
                        </MudTd>

                        <MudTd DataLabel="Admission No.">
                            @context.AdmissionNumber
                        </MudTd>

                        <MudTd DataLabel="Gender">
                            @context.Gender
                        </MudTd>

                        <MudTd DataLabel="Status">
                            <MudChip T="string"
                                     Size="Size.Small">
                                @context.Status
                            </MudChip>
                        </MudTd>

                        <MudTd>
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.OpenInNew"
                                       OnClick="@(() => ViewStudent(context.StudentId))">
                                View
                            </MudButton>
                        </MudTd>
                    </RowTemplate>

                </MudTable>
            }
            else
            {
                <MudAlert Severity="Severity.Info">
                    No students are linked to this parent.
                </MudAlert>
            }
        }

    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Close">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public ParentResponse Parent { get; set; } = default!;

    private ParentResponse _parent = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _parent = await ParentApi.GetParentAsync(Parent.Id)
                      ?? Parent;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ViewStudent(Guid studentId)
    {
        MudDialog.Close();
        Navigation.NavigateTo($"/students/{studentId}");
    }

    private void Close()
    {
        MudDialog.Close();
    }
}