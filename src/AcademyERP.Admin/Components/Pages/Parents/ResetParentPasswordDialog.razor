@using AcademyERP.Admin.Models
@using AcademyERP.Admin.Services
@using MudBlazor

@inject ParentApiService ParentApi
@inject ISnackbar Snackbar

<MudDialog>

    <DialogContent>

        <MudForm @ref="_form">

            <MudTextField Label="New Password" @bind-Value="_model.Password" InputType="InputType.Password"
                          Required="true" />

            <MudTextField Label="Confirm Password" @bind-Value="_model.ConfirmPassword" InputType="InputType.Password"
                          Required="true" />

        </MudForm>

    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">
            Save
        </MudButton>

    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Guid ParentId { get; set; }

    private MudForm? _form;

    private ResetParentPasswordRequest _model = new();

    private async Task Save()
    {
        await _form!.ValidateAsync();

        if (!_form.IsValid)
            return;

        if (_model.Password != _model.ConfirmPassword)
        {
            Snackbar.Add("Passwords do not match.", Severity.Error);
            return;
        }

        var success = await ParentApi.ResetPasswordAsync(ParentId, _model);

        if (success)
        {
            Snackbar.Add("Password reset successfully.", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        else
        {
            Snackbar.Add("Unable to reset password.", Severity.Error);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

}