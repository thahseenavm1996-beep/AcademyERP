             Search = ""
         });

         if (result != null)
         {
             _parents = result.Data.Items;
         }
     }*/
    private async Task LoadParents()
    {
        var result = await ParentApi.GetParentsAsync(new ParentQueryRequest
        {
            Page = 1,
            PageSize = 20,
            Search = ""
        });

        if (result == null)
        {
            Snackbar.Add("Result is NULL", Severity.Error);
            return;
        }

        Snackbar.Add($"Success = {result.Success}", Severity.Info);
        Snackbar.Add($"Items = {result.Data.Items.Count}", Severity.Info);

        _parents = result.Data.Items;
    }

    private async Task AddParent()
    {
        var dialog = await DialogService.ShowAsync<ParentDialog>(
            "Add Parent");

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadParents();
            StateHasChanged();
        }
    }

    private async Task EditParent(Guid id)
    {
        var parameters = new DialogParameters
        {
            { nameof(ParentDialog.ParentId), id },
            { nameof(ParentDialog.IsEdit), true }
        };

        var dialog = await DialogService.ShowAsync<ParentDialog>(
            "Update Parent",
            parameters);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadParents();
            StateHasChanged();
        }
    }

    private async Task DeleteParent(Guid id)
    {
        var success = await ParentApi.DeleteParentAsync(id);

        if (success)
        {
            Snackbar.Add("Teacher deleted successfully.", Severity.Success);
            await LoadParents();
        }
        else
        {
            Snackbar.Add("Failed to delete Teacher.", Severity.Error);
        }
    }
    private async Task ResetPassword(Guid id)
    {
        var parameters = new DialogParameters
    {
        { nameof(ResetParentPasswordDialog.ParentId), id }
    };

        var dialog = await DialogService.ShowAsync<ResetParentPasswordDialog>(
            "Reset Password",
            parameters);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add("Password reset successfully.", Severity.Success);
        }
    }
}