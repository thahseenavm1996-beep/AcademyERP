@page "/parents"

@using Microsoft.AspNetCore.Authorization
@using AcademyERP.Admin.Services
@using AcademyERP.Admin.Models
@using MudBlazor

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ParentApiService ParentApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Parents</PageTitle>

<MudPaper Class="pa-4">

    <!-- Page Header -->
    <MudStack Row="true"
              Justify="Justify.SpaceBetween"
              AlignItems="AlignItems.Center"
              Style="width:100%; flex-wrap:wrap; gap:12px;">

        <MudText Typo="Typo.h5">
            Parents
        </MudText>

        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   OnClick="AddParent">
            Add Parent
        </MudButton>

    </MudStack>

    <!-- Search Area -->
    <MudStack Row="true"
              Spacing="2"
              Class="mt-4 mb-4"
              AlignItems="AlignItems.Center"
              Style="width:100%; flex-wrap:wrap;">

       <MudTextField T="string"
              @bind-Value="_studentName"
              Placeholder="Search by Student Name..."
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.PersonSearch"
              Variant="Variant.Outlined"
              Margin="Margin.Dense"
              Class="flex-grow-1"
              Style="min-width:0;" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SearchParents">
            Search
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="ClearSearch">
            Clear
        </MudButton>

    </MudStack>

    <!-- Parents Table -->
    <MudTable Items="_parents"
              Hover="true"
              Dense="true"
              Striped="true">

        <HeaderContent>

            <MudTh>Name</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Email</MudTh>
            <MudTh>Status</MudTh>
            <MudTh></MudTh>

        </HeaderContent>

        <RowTemplate>

            <MudTd>
                @context.FullName
            </MudTd>

            <MudTd>
                @context.PhoneNumber
            </MudTd>

            <MudTd>
                @context.Email
            </MudTd>

            <MudTd>
                @context.Status
            </MudTd>

            <MudTd Align="Align.Right">

                <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                               Color="Color.Info"
                               Title="View parent details"
                               OnClick="@(() => ViewParent(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               OnClick="@(() => EditParent(context.Id))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => DeleteParent(context.Id))" />

                <MudIconButton Icon="@Icons.Material.Filled.LockReset"
                               Color="Color.Warning"
                               OnClick="@(() => ResetPassword(context.Id))" />

            </MudTd>

        </RowTemplate>

    </MudTable>

</MudPaper>

@code
{
    private List<ParentResponse> _parents = new();
    private string _studentName = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        Console.WriteLine(
            $"Authenticated: {state.User.Identity?.IsAuthenticated}");

        await LoadParents();
    }

    private async Task LoadParents()
    {
        var result = await ParentApi.GetParentsAsync(new ParentQueryRequest
        {
            Page = 1,
            PageSize = 20,
            Search = "",
            StudentName = _studentName
        });

        if (result == null)
        {
            Snackbar.Add("Result is NULL", Severity.Error);
            return;
        }

        

        _parents = result.Data.Items;
    }

    private async Task SearchParents()
    {
        await LoadParents();
    }

    private async Task ClearSearch()
    {
        _studentName = string.Empty;
        await LoadParents();
    }

    private async Task AddParent()
    {
        var dialog = await DialogService.ShowAsync<ParentDialog>(
            "Add Parent");

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadParents();
            StateHasChanged();
        }
    }

    private async Task EditParent(Guid id)
    {
        var parameters = new DialogParameters
        {
            { nameof(ParentDialog.ParentId), id },
            { nameof(ParentDialog.IsEdit), true }
        };

        var dialog = await DialogService.ShowAsync<ParentDialog>(
            "Update Parent",
            parameters);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadParents();
            StateHasChanged();
        }
    }

    private async Task ViewParent(ParentResponse parent)
    {
        await DialogService.ShowAsync<ParentDetailsDialog>(
            "Parent Details",
            new DialogParameters
            {
                [nameof(ParentDetailsDialog.Parent)] = parent
            });
    }

    private async Task DeleteParent(Guid id)
    {
        var success = await ParentApi.DeleteParentAsync(id);

        if (success)
        {
            Snackbar.Add(
                "Parent deleted successfully.",
                Severity.Success);

            await LoadParents();
        }
        else
        {
            Snackbar.Add(
                "Failed to delete Parent.",
                Severity.Error);
        }
    }

    private async Task ResetPassword(Guid id)
    {
        var parameters = new DialogParameters
        {
            { nameof(ResetParentPasswordDialog.ParentId), id }
        };

        var dialog = await DialogService.ShowAsync<ResetParentPasswordDialog>(
            "Reset Password",
            parameters);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add(
                "Password reset successfully.",
                Severity.Success);
        }
    }
}