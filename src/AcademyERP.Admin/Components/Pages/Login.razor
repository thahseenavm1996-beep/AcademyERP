@page "/login"
@layout EmptyLayout

@using AcademyERP.Admin.Components.Layout
@using AcademyERP.Admin.Models
@using AcademyERP.Admin.Services
@using AcademyERP.Admin.Authentication
@using Microsoft.AspNetCore.Components.Authorization

@inject TokenService TokenService
@inject AuthApiService AuthApi
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<MudPaper Width="400px" Class="pa-6 mx-auto mt-12">

     

         <div class="academy-brand academy-brand-sidebar">
    <img src="/images/Clogo.png"
         alt="MS Academy International"
         class="academy-logo" />
</div>


    <MudText Typo="Typo.subtitle1" Align="Align.Center" Class="mb-4">
        Login
    </MudText>

    <MudTextField Label="Email"
                  @bind-Value="_model.Email"
                  Required="true" />

    <MudTextField Label="Password"
                  InputType="InputType.Password"
                  @bind-Value="_model.Password"
                  Required="true" />

    <MudButton FullWidth="true"
               Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="LoginUser"
               Class="mt-4">

        Login

    </MudButton>
   <MudButton FullWidth="true"
           Variant="Variant.Outlined"
           Color="Color.Primary"
           OnClick="InstallApp"
           Class="mt-3"
           id="installAppBtn">

    📱 Install MS Academy App

</MudButton>

</MudPaper>

@code
{
    private LoginRequest _model = new();

    private async Task LoginUser()
    {
        var result = await AuthApi.LoginAsync(_model);

        if (result == null)
        {
            Snackbar.Add("Invalid email or password.", Severity.Error);
            return;
        }

        await TokenService.SaveTokenAsync(result.Token);

        ((JwtAuthenticationStateProvider)AuthenticationStateProvider)
            .NotifyUserAuthentication();

        Snackbar.Add("Login successful.", Severity.Success);

        var authState = await AuthenticationStateProvider
    .GetAuthenticationStateAsync();

var user = authState.User;


if (user.IsInRole("Teacher"))
{
    Navigation.NavigateTo("/Teachers/TeacherDashboard");
}
else if (user.IsInRole("Parent"))
{
    Navigation.NavigateTo("/Parent/Dashboard");
}
else
{
    Navigation.NavigateTo("/");
}
    }

    private async Task InstallApp()
{
    await JS.InvokeVoidAsync("installAcademyApp");
}
}