@page "/reports/students"

@using AcademyERP.Admin.Models.Enrollments
@using AcademyERP.Admin.Services
@using AcademyERP.Admin.Models.StudentReports
@using AcademyERP.Domain.Enums

@inject StudentReportApiService StudentReportApi
@inject EnrollmentApiService EnrollmentApi

<PageTitle>Student Reports</PageTitle>

<!-- Filters -->
<MudPaper Class="pa-4 mb-5">
    <MudGrid>

        <MudItem xs="12" sm="6" md="4">

            <MudSelect T="string"
                       Label="Course"
                       Variant="Variant.Outlined"
                       @bind-Value="_courseName">

                <MudSelectItem Value="@string.Empty">
                    All Courses
                </MudSelectItem>

                @foreach (var course in CourseNames)
                {
                    <MudSelectItem Value="@course">
                        @course
                    </MudSelectItem>
                }

            </MudSelect>

        </MudItem>

        <MudItem xs="12" sm="6" md="4">

            <MudSelect T="Gender?"
                       Label="Gender"
                       Variant="Variant.Outlined"
                       @bind-Value="_gender">

                <MudSelectItem T="Gender?"
                               Value="@((Gender?)null)">
                    All
                </MudSelectItem>

                <MudSelectItem T="Gender?"
                               Value="@Gender.Male">
                    Male
                </MudSelectItem>

                <MudSelectItem T="Gender?"
                               Value="@Gender.Female">
                    Female
                </MudSelectItem>

                <MudSelectItem T="Gender?"
                               Value="@Gender.Other">
                    Other
                </MudSelectItem>

            </MudSelect>

        </MudItem>

        <MudItem xs="12" sm="6" md="4">

            <MudStack Row="true"
                      Spacing="2"
                      Class="mt-2">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="ApplyFilters">

                    SEARCH

                </MudButton>

                <MudButton Variant="Variant.Outlined"
                           OnClick="ClearFilters">

                    CLEAR

                </MudButton>

            </MudStack>

        </MudItem>

    </MudGrid>
</MudPaper>


@if (_dashboard != null)
{
    <MudGrid Class="mb-5">

        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5 text-center">

                <MudIcon Icon="@Icons.Material.Filled.Groups"
                         Color="Color.Primary"
                         Size="Size.Large" />

                <MudText Typo="Typo.h4">
                    @_dashboard.TotalStudents
                </MudText>

                <MudText>
                    Total Students
                </MudText>

            </MudPaper>

        </MudItem>


        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5 text-center">

                <MudIcon Icon="@Icons.Material.Filled.Person"
                         Color="Color.Success"
                         Size="Size.Large" />

                <MudText Typo="Typo.h4">
                    @_dashboard.ActiveStudents
                </MudText>

                <MudText>
                    Active Students
                </MudText>

            </MudPaper>

        </MudItem>


        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5 text-center">

                <MudIcon Icon="@Icons.Material.Filled.TrendingUp"
                         Color="Color.Info"
                         Size="Size.Large" />

                <MudText Typo="Typo.h4">
                    @_dashboard.AveragePerformance%
                </MudText>

                <MudText>
                    Average Performance
                </MudText>

            </MudPaper>

        </MudItem>


        <MudItem xs="12" sm="6" md="3">

            <MudPaper Class="pa-5 text-center">

                <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                         Color="Color.Warning"
                         Size="Size.Large" />

                <MudText Typo="Typo.h4">
                    @_dashboard.AverageAttendance%
                </MudText>

                <MudText>
                    Average Attendance
                </MudText>

            </MudPaper>

        </MudItem>

    </MudGrid>
}


@if (_dashboard?.BestStudent != null)
{
    <MudPaper Class="pa-6 mt-5 elevation-3">

        <MudText Typo="Typo.h5">
            ⭐ Best Performing Student
        </MudText>

        <MudDivider Class="my-4" />

        <MudGrid>

            <MudItem xs="12" md="6">

                <MudText Typo="Typo.h6">
                    @_dashboard.BestStudent.StudentName
                </MudText>

                <MudText>
                    Course:
                    <b>
                        @_dashboard.BestStudent.CourseName
                    </b>
                </MudText>

            </MudItem>


            <MudItem xs="12" md="3">

                <MudText>
                    Performance
                </MudText>

                <MudText Typo="Typo.h5">
                    @_dashboard.BestStudent.PerformanceScore%
                </MudText>

            </MudItem>


            <MudItem xs="12" md="3">

                <MudText>
                    Attendance
                </MudText>

                <MudText Typo="Typo.h5">
                    @_dashboard.BestStudent.AttendancePercentage%
                </MudText>

            </MudItem>

        </MudGrid>

    </MudPaper>
}


<MudGrid Class="mt-6">

    <!-- Attendance Summary -->
    <MudItem xs="12" md="4">

        <MudPaper Class="pa-4">

            <MudText Typo="Typo.h6">
                📅 Attendance Summary
            </MudText>

            <MudDivider Class="my-3" />

            <MudText>
                🟢 Present:
                <b>@_dashboard?.AttendanceSummary.PresentPercentage%</b>
            </MudText>

            <MudText>
                🔴 Absent:
                <b>@_dashboard?.AttendanceSummary.AbsentPercentage%</b>
            </MudText>

            <MudText>
                🟡 Leave:
                <b>@_dashboard?.AttendanceSummary.LeavePercentage%</b>
            </MudText>

            <MudText>
                🟠 Late:
                <b>@_dashboard?.AttendanceSummary.LatePercentage%</b>
            </MudText>

        </MudPaper>

    </MudItem>


    <!-- Fee Summary -->
    <MudItem xs="12" md="4">

        <MudPaper Class="pa-4">

            <MudText Typo="Typo.h6">
                💰 Fee Summary
            </MudText>

            <MudDivider Class="my-3" />

            <MudText>
                Total Collected:
                <b>₹ @_dashboard?.FeeSummary.TotalCollected</b>
            </MudText>

            <MudText>
                Pending Amount:
                <b>₹ @_dashboard?.FeeSummary.PendingAmount</b>
            </MudText>

            <MudText>
                Paid Students:
                <b>@_dashboard?.FeeSummary.PaidStudents</b>
            </MudText>

            <MudText>
                Pending Students:
                <b>@_dashboard?.FeeSummary.PendingStudents</b>
            </MudText>

        </MudPaper>

    </MudItem>


    <!-- Learning Summary -->
    <MudItem xs="12" md="4">

        <MudPaper Class="pa-4">

            <MudText Typo="Typo.h6">
                📚 Learning Summary
            </MudText>

            <MudDivider Class="my-3" />

            <MudText>
                Average Progress:
                <b>@_dashboard?.LearningSummary.AverageProgress%</b>
            </MudText>

            <MudProgressLinear
                Value="@((double)(_dashboard?.LearningSummary.AverageProgress ?? 0))"
                Rounded="true"
                Class="mt-3" />

            <MudText Class="mt-3">
                Lessons Completed:
                <b>@_dashboard?.LearningSummary.TotalLessonsCompleted</b>
            </MudText>

        </MudPaper>

    </MudItem>

</MudGrid>


<MudPaper Class="pa-4 mt-6">

    <MudText Typo="Typo.h5">
        📊 Attendance Distribution
    </MudText>

    <MudChart T="double"
              ChartType="ChartType.Bar"
              ChartSeries="@AttendanceDistributionSeries"
              ChartLabels="@AttendanceDistributionLabels"
              Height="350px" />

</MudPaper>


@if (_dashboard?.PerformanceTrend?.Count > 0)
{
    <MudPaper Class="pa-5 mt-5">

        <MudText Typo="Typo.h5">
            📈 Student Performance Trend
        </MudText>

        @if (_dashboard.PerformanceTrend.Count == 1)
        {
            var performance = _dashboard.PerformanceTrend[0];

            <MudAlert Severity="Severity.Info" Class="mt-4">

                Performance data is currently available for
                <strong>@performance.Month</strong> only.

                Current performance:
                <strong>@performance.Score.ToString("0.##")%</strong>.

                More data will appear as additional class reports are recorded.

            </MudAlert>

            <div class="d-flex justify-center align-center mt-4"
                 style="height: 220px;">

                <div class="text-center">

                    <MudText Typo="Typo.h2">
                        @performance.Score.ToString("0.##")%
                    </MudText>

                    <MudText Typo="Typo.body1">
                        @performance.Month
                    </MudText>

                </div>

            </div>
        }
        else
        {
            <MudChart T="double"
                      ChartType="ChartType.Line"
                      ChartSeries="@PerformanceSeries"
                      ChartLabels="@PerformanceLabels"
                      ChartOptions="@PerformanceChartOptions"
                      Height="400px" />
        }

    </MudPaper>
}
else
{
    <MudPaper Class="pa-5 mt-5">

        <MudText Typo="Typo.h5">
            📈 Student Performance Trend
        </MudText>

        <MudAlert Severity="Severity.Info" Class="mt-4">

            No performance data is available yet.
            Performance trends will appear after class reports are recorded.

        </MudAlert>

    </MudPaper>
}


<MudPaper Class="pa-4 mt-6">

    <MudText Typo="Typo.h5">
        📊 Student Attendance Trend
    </MudText>

    <MudChart T="double"
              ChartType="ChartType.Line"
              ChartSeries="@AttendanceSeries"
              ChartLabels="@AttendanceLabels"
              ChartOptions="@AttendanceChartOptions"
              Height="400px" />

</MudPaper>


<MudPaper Class="pa-4 mt-6">

    <MudText Typo="Typo.h5">
        📚 Course-wise Student Distribution
    </MudText>

    <MudChart T="double"
              ChartType="ChartType.Bar"
              ChartSeries="@CourseSeries"
              ChartLabels="@CourseLabels"
              ChartOptions="@CourseChartOptions"
              Height="400px" />

</MudPaper>


<MudPaper Class="pa-4 mt-6">

    <MudText Typo="Typo.h5">
        🏆 Student Ranking
    </MudText>

    <MudTable Items="_dashboard?.StudentRanking ?? new List<StudentRankingDto>()">

        <HeaderContent>

            <MudTh>Rank</MudTh>
            <MudTh>Student</MudTh>
            <MudTh>Course</MudTh>
            <MudTh>Performance</MudTh>
            <MudTh>Attendance</MudTh>

        </HeaderContent>


        <RowTemplate Context="student">

            <MudTd>
                @student.Rank
            </MudTd>

            <MudTd>
                <b>@student.StudentName</b>
            </MudTd>

            <MudTd>
                @student.CourseName
            </MudTd>

            <MudTd>
                @student.PerformanceScore%
            </MudTd>

            <MudTd>
                @student.Attendance%
            </MudTd>

        </RowTemplate>

    </MudTable>

</MudPaper>


<MudPaper Class="pa-4 mt-6">

    <MudText Typo="Typo.h5">
        📚 Learning Progress Overview
    </MudText>

    <MudTable Items="_dashboard?.LearningProgress
        ?? new List<StudentLearningProgressDto>()">

        <HeaderContent>

            <MudTh>Student</MudTh>
            <MudTh>Course</MudTh>
            <MudTh>Lessons Completed</MudTh>
            <MudTh>Pages Covered</MudTh>
            <MudTh>Progress</MudTh>

        </HeaderContent>


        <RowTemplate Context="student">

            <MudTd>
                <b>@student.StudentName</b>
            </MudTd>

            <MudTd>
                @student.CourseName
            </MudTd>

            <MudTd>
                @student.LessonsCompleted
            </MudTd>

            <MudTd>
                @student.PagesCovered
            </MudTd>

            <MudTd>

                <MudProgressLinear
                    Value="@((double)student.ProgressPercentage)"
                    Rounded="true" />

                <MudText Typo="Typo.caption">
                    @student.ProgressPercentage%
                </MudText>

            </MudTd>

        </RowTemplate>

    </MudTable>

</MudPaper>


<MudPaper Class="pa-4 mt-6">

    <MudText Typo="Typo.h5">
        💰 Fee Status Overview
    </MudText>

    <MudTable Items="_dashboard?.FeeStatus
        ?? new List<StudentFeeStatusDto>()">

        <HeaderContent>

            <MudTh>Student</MudTh>
            <MudTh>Course</MudTh>
            <MudTh>Monthly Fee</MudTh>
            <MudTh>Last Payment</MudTh>
            <MudTh>Next Due Date</MudTh>
            <MudTh>Status</MudTh>

        </HeaderContent>


        <RowTemplate Context="fee">

            <MudTd>
                <b>@fee.StudentName</b>
            </MudTd>

            <MudTd>
                @fee.CourseName
            </MudTd>

            <MudTd>
                ₹ @fee.MonthlyFee
            </MudTd>

            <MudTd>
                @fee.LastPaymentDate
            </MudTd>

            <MudTd>
                @fee.NextDueDate
            </MudTd>

            <MudTd>

                @if (fee.Status == "Paid")
                {
                    <MudChip T="string"
                             Color="Color.Success">
                        Paid
                    </MudChip>
                }
                else if (fee.Status == "Pending")
                {
                    <MudChip T="string"
                             Color="Color.Error">
                        Pending
                    </MudChip>
                }
                else
                {
                    <MudChip T="string"
                             Color="Color.Warning">
                        @fee.Status
                    </MudChip>
                }

            </MudTd>

        </RowTemplate>

    </MudTable>

</MudPaper>


@code {

    private List<EnrollmentResponse> _enrollments = new();

    private StudentReportDashboardResponse? _dashboard;

    private string _courseName = string.Empty;

    private Gender? _gender;

    private List<string> CourseNames = new();


    private List<ChartSeries<double>> PerformanceSeries = new();

    private string[] PerformanceLabels = Array.Empty<string>();


    private List<ChartSeries<double>> AttendanceSeries = new();

    private string[] AttendanceLabels = Array.Empty<string>();

    private ChartOptions AttendanceChartOptions = new();


    private List<ChartSeries<double>> CourseSeries = new();

    private string[] CourseLabels = Array.Empty<string>();

    private BarChartOptions CourseChartOptions = new()
    {
        XAxisLabelRotation = 45,
        XAxisTitle = "Courses",
        YAxisTitle = "Students"
    };


    private List<ChartSeries<double>> AttendanceDistributionSeries = new();

    private string[] AttendanceDistributionLabels =
    [
        "Present",
        "Absent",
        "Leave",
        "Late"
    ];


    protected override async Task OnInitializedAsync()
    {
        // Load enrollments so we can populate the Course filter.
        _enrollments = await EnrollmentApi.GetAllAsync();

        CourseNames = _enrollments
            .Where(x => !string.IsNullOrWhiteSpace(x.CourseName))
            .Select(x => x.CourseName!)
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        // Load the dashboard using the current filters.
        await LoadDashboardAsync();
    }


    private async Task LoadDashboardAsync()
    {
        _dashboard =
            await StudentReportApi.GetDashboardAsync(
                string.IsNullOrWhiteSpace(_courseName)
                    ? null
                    : _courseName,
                _gender.HasValue
                    ? (int)_gender.Value
                    : null);


        if (_dashboard == null)
        {
            _dashboard = new StudentReportDashboardResponse();
        }


        // Performance chart
        if (_dashboard.PerformanceTrend != null)
        {
            PerformanceLabels =
                _dashboard.PerformanceTrend
                    .Select(x => x.Month)
                    .ToArray();

            PerformanceSeries =
            [
                new ChartSeries<double>
                {
                    Name = "Performance",

                    Data =
                        _dashboard.PerformanceTrend
                            .Select(x => (double)x.Score)
                            .ToArray()
                }
            ];
        }
        else
        {
            PerformanceLabels = Array.Empty<string>();
            PerformanceSeries = new List<ChartSeries<double>>();
        }


        // Attendance chart
        AttendanceLabels =
            _dashboard.AttendanceTrend
                .Select(x => x.Month)
                .ToArray();

        AttendanceSeries =
        [
            new ChartSeries<double>
            {
                Name = "Attendance",

                Data =
                    _dashboard.AttendanceTrend
                        .Select(x => (double)x.Attendance)
                        .ToArray()
            }
        ];


        // Course distribution chart
        CourseLabels =
            _dashboard.CourseDistribution
                .Select(x => x.CourseName)
                .ToArray();

        CourseSeries =
        [
            new ChartSeries<double>
            {
                Name = "Students",

                Data =
                    _dashboard.CourseDistribution
                        .Select(x => (double)x.Students)
                        .ToArray()
            }
        ];


        // Attendance distribution
        // Keeping the existing values for now.
        AttendanceDistributionSeries =
[
    new ChartSeries<double>
    {
        Name = "Attendance",

        Data = new List<double>
        {
            92,
            5,
            2,
            1
        }.ToArray()
    }
];
    }


    private async Task ApplyFilters()
    {
        await LoadDashboardAsync();
    }


    private async Task ClearFilters()
    {
        _courseName = string.Empty;

        _gender = null;

        await LoadDashboardAsync();
    }


    private LineChartOptions PerformanceChartOptions = new()
    {
        XAxisLabelRotation = 45,
        XAxisTitle = "Month",
        YAxisTitle = "Performance %"
    };

}