@page "/reports/attendance"

@using AcademyERP.Admin.Models.AttendanceReports
@using AcademyERP.Admin.Services
@using Microsoft.JSInterop
@inject AttendanceReportApiService AttendanceReportApi
@inject IJSRuntime JS

<MudStack Row="true"
          Justify="Justify.SpaceBetween"
          AlignItems="AlignItems.Center"
          Class="mb-4">

    <MudText Typo="Typo.h4">
        Attendance Reports
    </MudText>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PictureAsPdf"
               OnClick="DownloadPdfAsync"
               Disabled="@_downloadingPdf">

        @if (_downloadingPdf)
        {
            <MudProgressCircular Size="Size.Small"
                                 Indeterminate="true"
                                 Class="mr-2" />
            <span>Generating...</span>
        }
        else
        {
            <span>Download PDF</span>
        }

    </MudButton>

</MudStack>


@if (_dashboard == null)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{

    <!-- SUMMARY CARDS -->

    <MudGrid Class="mt-6">


        <MudItem xs="12" sm="6" md="3">

            <MudCard>

                <MudCardContent>

                    <MudText Typo="Typo.subtitle2">
                        Total Classes
                    </MudText>

                    <MudText Typo="Typo.h4">
                        @_dashboard.TotalClasses
                    </MudText>

                </MudCardContent>

            </MudCard>

        </MudItem>



        <MudItem xs="12" sm="6" md="3">

            <MudCard>

                <MudCardContent>

                    <MudText Typo="Typo.subtitle2">
                        Completed Classes
                    </MudText>

                    <MudText Typo="Typo.h4">
                        @_dashboard.CompletedClasses
                    </MudText>

                </MudCardContent>

            </MudCard>

        </MudItem>



        <MudItem xs="12" sm="6" md="3">

            <MudCard>

                <MudCardContent>

                    <MudText Typo="Typo.subtitle2">
                        Attendance Records
                    </MudText>

                    <MudText Typo="Typo.h4">
                        @_dashboard.TotalAttendanceRecords
                    </MudText>

                </MudCardContent>

            </MudCard>

        </MudItem>



        <MudItem xs="12" sm="6" md="3">

            <MudCard>

                <MudCardContent>

                    <MudText Typo="Typo.subtitle2">
                        Average Attendance
                    </MudText>

                    <MudText Typo="Typo.h4">
                        @_dashboard.AverageAttendance%
                    </MudText>

                </MudCardContent>

            </MudCard>

        </MudItem>


    </MudGrid>



    <!-- ATTENDANCE TREND -->


    <MudPaper Class="pa-4 mt-6">

        <MudText Typo="Typo.h5">
            📈 Attendance Trend
        </MudText>


        <MudChart T="double"
                  ChartType="ChartType.Line"
                  ChartSeries="@AttendanceTrendSeries"
                  XAxisLabels="@AttendanceTrendLabels"
                  Height="350px" />

    </MudPaper>




    <!-- STATUS DISTRIBUTION -->


    <MudPaper Class="pa-4 mt-6">

        <MudText Typo="Typo.h5">
            📊 Attendance Status Distribution
        </MudText>


        <MudChart T="double"
                  ChartType="ChartType.Bar"
                  ChartSeries="@StatusSeries"
                  ChartLabels="@StatusLabels"
                  Height="350px" />

    </MudPaper>




    <!-- COURSE ATTENDANCE -->


    <MudPaper Class="pa-4 mt-6">

        <MudText Typo="Typo.h5">
            📚 Course Attendance
        </MudText>


        <MudChart T="double"
          ChartType="ChartType.Bar"
          ChartSeries="@CourseSeries"
          ChartLabels="@CourseLabels"
          ChartOptions="@CourseChartOptions"
          Height="450px" />

    </MudPaper>




    <!-- LOW ATTENDANCE STUDENTS -->


    <MudPaper Class="pa-4 mt-6">

        <MudText Typo="Typo.h5">
            ⚠️ Students Needing Attention
        </MudText>


        <MudTable Items="_dashboard.StudentsNeedingAttention">


            <HeaderContent>

                <MudTh>
                    Student
                </MudTh>

                <MudTh>
                    Course
                </MudTh>

                <MudTh>
                    Attendance
                </MudTh>

            </HeaderContent>


            <RowTemplate Context="student">

                <MudTd>
                    @student.StudentName
                </MudTd>


                <MudTd>
                    @student.CourseName
                </MudTd>


                <MudTd>
                    @student.AttendancePercentage%
                </MudTd>


            </RowTemplate>


        </MudTable>


    </MudPaper>




    <!-- TEACHER SUMMARY -->


    <MudPaper Class="pa-4 mt-6">


        <MudText Typo="Typo.h5">
            👨‍🏫 Teacher Attendance Summary
        </MudText>



        <MudTable Items="_dashboard.TeacherSummary">


            <HeaderContent>

                <MudTh>
                    Teacher
                </MudTh>

                <MudTh>
                    Total Classes
                </MudTh>

                <MudTh>
                    Attendance
                </MudTh>


            </HeaderContent>



            <RowTemplate Context="teacher">


                <MudTd>
                    @teacher.TeacherName
                </MudTd>


                <MudTd>
                    @teacher.TotalClasses
                </MudTd>


                <MudTd>
                    @teacher.AttendancePercentage%
                </MudTd>


            </RowTemplate>


        </MudTable>


    </MudPaper>

}



@code {


    private AttendanceReportDashboardResponse? _dashboard;



    private List<ChartSeries<double>> AttendanceTrendSeries = new();

    private string[] AttendanceTrendLabels = Array.Empty<string>();



    private List<ChartSeries<double>> StatusSeries = new();

    private string[] StatusLabels = Array.Empty<string>();



   private List<ChartSeries<double>> CourseSeries = new();

private string[] CourseLabels = Array.Empty<string>();

private BarChartOptions CourseChartOptions = new()
{
    XAxisLabelRotation = 45,
    XAxisTitle = "Courses",
    YAxisTitle = "Attendance %"
};





    protected override async Task OnInitializedAsync()
    {

        _dashboard =
            await AttendanceReportApi.GetAsync();



        if (_dashboard == null)
            return;



        AttendanceTrendLabels =
            _dashboard.AttendanceTrend
            .Select(x => x.Month)
            .ToArray();



        AttendanceTrendSeries =
        [
            new ChartSeries<double>
            {
                Name = "Attendance",

                Data =
                    _dashboard.AttendanceTrend
                    .Select(x => (double)x.Percentage)
                    .ToArray()
            }
        ];




        StatusLabels =
            _dashboard.StatusDistribution
            .Select(x => x.Status)
            .ToArray();



        StatusSeries =
        [
            new ChartSeries<double>
            {
                Name = "Attendance",

                Data =
                    _dashboard.StatusDistribution
                    .Select(x => (double)x.Count)
                    .ToArray()
            }
        ];




        CourseLabels =
            _dashboard.CourseAttendance
            .Select(x => x.CourseName)
            .ToArray();



        CourseSeries =
        [
            new ChartSeries<double>
            {
                Name = "Attendance",

                Data =
                    _dashboard.CourseAttendance
                    .Select(x => (double)x.AttendancePercentage)
                    .ToArray()
            }
        ];

    }

private bool _downloadingPdf;

private async Task DownloadPdfAsync()
{
    try
    {
        _downloadingPdf = true;

        var pdf =
            await AttendanceReportApi.DownloadPdfAsync();

        var base64 =
            Convert.ToBase64String(pdf);

        await JS.InvokeVoidAsync(
            "downloadFile",
            "attendance-report.pdf",
            "application/pdf",
            base64);
    }
    finally
    {
        _downloadingPdf = false;
    }
}


}