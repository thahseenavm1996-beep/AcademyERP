@page "/TeacherPayments"

@using AcademyERP.Admin.Models.ClassReports
@using AcademyERP.Admin.Models.TeacherPayments
@using AcademyERP.Admin.Services

@inject TeacherPaymentApiService TeacherPaymentApi
@inject ISnackbar Snackbar

<PageTitle>Teacher Payments</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4">

    <MudText Typo="Typo.h5" Class="mb-1">
        Teacher Payments
    </MudText>

    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
        Manage teacher payment cycles, pending payments and payment history.
    </MudText>

    <!-- Summary / Actions -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">

        <MudStack Row="true"
                  Justify="Justify.SpaceBetween"
                  AlignItems="AlignItems.Center"
                  Wrap="Wrap.Wrap">

           <MudStack Row="true"
          Spacing="2"
          AlignItems="AlignItems.Center"
          Style="flex-wrap:wrap;">

                <MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Autorenew"
           Disabled="@_generating"
           OnClick="GeneratePayments"
           Style="white-space:nowrap;">

                    @if (_generating)
                    {
                        <MudProgressCircular Size="Size.Small"
                                             Indeterminate="true"
                                             Class="mr-2" />
                        <span>Generating...</span>
                    }
                    else
                    {
                        <span>Generate Current Cycles</span>
                    }

                </MudButton>

                <MudButton Variant="Variant.Outlined"
           StartIcon="@Icons.Material.Filled.Refresh"
           OnClick="LoadPayments"
           Style="white-space:nowrap;">
    Refresh
</MudButton>

            </MudStack>

            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Showing @_payments.Count of @_totalCount payments
            </MudText>

        </MudStack>

    </MudPaper>

    <!-- Filters -->
    <MudPaper Class="pa-4 mb-4" Elevation="1">

        <MudText Typo="Typo.subtitle1" Class="mb-3">
            Filters
        </MudText>

        <MudGrid>

            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_teacherName"
                              Label="Teacher"
                              Placeholder="Search teacher"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_studentName"
                              Label="Student"
                              Placeholder="Search student"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker @bind-Date="_fromDate"
                               Label="From Date"
                               Variant="Variant.Outlined"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudDatePicker @bind-Date="_toDate"
                               Label="To Date"
                               Variant="Variant.Outlined"
                               Clearable="true" />
            </MudItem>

            <MudItem xs="12" sm="6" md="4"
         Class="d-flex align-center">

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@Icons.Material.Filled.Search"
                           OnClick="ApplyFilters">

                    Search

                </MudButton>

            </MudItem>

        </MudGrid>

    </MudPaper>

    <!-- Payment Table -->
    <MudPaper Elevation="1">

       <MudTable Items="_payments"
          Hover="true"
          Dense="true"
          Striped="true"
          Bordered="true"
          Loading="_loading"
          Breakpoint="Breakpoint.None">

            <HeaderContent>

                <MudTh>Teacher</MudTh>
                <MudTh>Student</MudTh>
                <MudTh>Course</MudTh>
                <MudTh>Cycle</MudTh>
                <MudTh>Due Date</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Paid Date</MudTh>
                <MudTh>Actions</MudTh>

            </HeaderContent>

            <RowTemplate>

                <MudTd DataLabel="Teacher">
                    @context.TeacherName
                </MudTd>

                <MudTd DataLabel="Student">
                    @context.StudentName
                </MudTd>

                <MudTd DataLabel="Course">
                    @context.CourseName
                </MudTd>

                <MudTd DataLabel="Cycle">
    <div>
        <strong>
            @context.CycleStartDate.ToLocalTime().ToString("dd MMM yyyy")
            -
            @context.CycleEndDate.ToLocalTime().ToString("dd MMM yyyy")
        </strong>
    </div>

    <div style="font-size: 0.82rem; color: #666;">
        Payable:
        @context.PayableFromDate.ToLocalTime().ToString("dd MMM yyyy")
        -
        @context.PayableToDate.ToLocalTime().ToString("dd MMM yyyy")
    </div>

    <div style="font-size: 0.82rem; color: #666;">
        @context.PayableDays / @context.CycleScheduledDays scheduled days
    </div>
</MudTd>

                <MudTd DataLabel="Due Date">
                    @context.DueDate.ToString("dd MMM yyyy")
                </MudTd>

               <MudTd DataLabel="Amount">
    <strong>₹@context.Amount.ToString("N2")</strong>

    @if (context.PayableDays < context.CycleScheduledDays)
    {
        <div style="font-size: 0.78rem; color: #666;">
            Prorated
        </div>
    }
</MudTd>

                <MudTd DataLabel="Status">

                    @switch (context.Status)
                    {
                        case 1:
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Warning">
                                Pending
                            </MudChip>
                            break;

                        case 2:
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Success">
                                Paid
                            </MudChip>
                            break;

                        case 3:
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="Color.Error">
                                Cancelled
                            </MudChip>
                            break;

                        default:
                            <MudChip T="string"
                                     Size="Size.Small">
                                Unknown
                            </MudChip>
                            break;
                    }

                </MudTd>

                <MudTd DataLabel="Paid Date">
                    @(context.PaidDate.HasValue
                        ? context.PaidDate.Value.ToString("dd MMM yyyy")
                        : "-")
                </MudTd>

                <MudTd DataLabel="Actions">

                    @if (context.Status == 1)
                    {
                        <MudStack Row="true" Spacing="1">

                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Success"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.CheckCircle"
                                       OnClick="@(() => OpenMarkPaidDialog(context))">

                                Mark Paid

                            </MudButton>

                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           Title="Cancel Payment"
                                           OnClick="@(() => CancelPayment(context))" />

                        </MudStack>
                    }
                    else if (context.Status == 2)
                    {
                        <MudText Typo="Typo.caption"
                                 Color="Color.Success">
                            Payment completed
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption"
                                 Color="Color.Error">
                            Cancelled
                        </MudText>
                    }

                </MudTd>

            </RowTemplate>

            <NoRecordsContent>

                <MudText Class="pa-6"
                         Align="Align.Center"
                         Color="Color.Secondary">

                    No teacher payments found.

                </MudText>

            </NoRecordsContent>

            <LoadingContent>

                <MudText Class="pa-6"
                         Align="Align.Center">

                    Loading payments...

                </MudText>

            </LoadingContent>

        </MudTable>

        @if (_totalPages > 1)
        {
            <MudDivider />

            <MudStack Row="true"
                      Justify="Justify.Center"
                      Class="pa-4">

               <MudPagination Count="_totalPages"
               Selected="_page"
               SelectedChanged="PageChanged"
               Color="Color.Primary"
               Size="Size.Medium" />
            </MudStack>
        }

    </MudPaper>

</MudContainer>

<!-- Mark Paid Dialog -->
@if (_showMarkPaidDialog && _selectedPayment != null)
{
    <MudDialog @bind-Visible="_showMarkPaidDialog">

        <DialogContent>

            <MudText Typo="Typo.h6" Class="mb-2">
                Mark Payment as Paid
            </MudText>

            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                @_selectedPayment.TeacherName →
                @_selectedPayment.StudentName
            </MudText>

            <MudPaper Class="pa-3 mb-4" Outlined="true">

                <MudStack Spacing="1">

                    <MudText>
                        <strong>Course:</strong>
                        @_selectedPayment.CourseName
                    </MudText>

                    <MudText>
                        <strong>Cycle:</strong>
                        @_selectedPayment.CycleStartDate.ToString("dd MMM yyyy")
                        -
                        @_selectedPayment.CycleEndDate.ToString("dd MMM yyyy")
                    </MudText>

                    <MudText>
                        <strong>Amount:</strong>
                        ₹@_selectedPayment.Amount.ToString("N2")
                    </MudText>

                </MudStack>

            </MudPaper>

            <MudDatePicker @bind-Date="_paidDate"
                           Label="Paid Date"
                           Variant="Variant.Outlined"
                           Required="true"
                           Class="mb-3" />

            <MudTextField @bind-Value="_transactionReference"
                          Label="Transaction Reference"
                          Placeholder="Optional"
                          Variant="Variant.Outlined"
                          Class="mb-3" />

            <MudTextField @bind-Value="_paymentRemarks"
                          Label="Remarks"
                          Placeholder="Optional"
                          Variant="Variant.Outlined"
                          Lines="3" />

        </DialogContent>

        <DialogActions>

            <MudButton Variant="Variant.Text"
                       OnClick="CloseMarkPaidDialog">

                Cancel

            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.CheckCircle"
                       Disabled="@_savingPayment"
                       OnClick="MarkPaymentPaid">

                @if (_savingPayment)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Indeterminate="true"
                                         Class="mr-2" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Confirm Payment</span>
                }

            </MudButton>

        </DialogActions>

    </MudDialog>
}

@code {

    private List<TeacherPaymentResponse> _payments = [];

    private string? _teacherName;
    private string? _studentName;

    private DateTime? _fromDate;
    private DateTime? _toDate;

    private int _page = 1;
    private int _pageSize = 20;
    private int _totalCount;
    private int _totalPages;

    private bool _loading;
    private bool _generating;
    private bool _savingPayment;

    private bool _showMarkPaidDialog;
    private TeacherPaymentResponse? _selectedPayment;

    private DateTime? _paidDate = DateTime.Today;
    private string? _transactionReference;
    private string? _paymentRemarks;

    protected override async Task OnInitializedAsync()
    {
        await LoadPayments();
    }

    private async Task LoadPayments()
    {
        try
        {
            _loading = true;

            var request = new TeacherPaymentQueryRequest
            {
                Page = _page,
                PageSize = _pageSize,
                TeacherName = string.IsNullOrWhiteSpace(_teacherName)
                    ? null
                    : _teacherName.Trim(),
                StudentName = string.IsNullOrWhiteSpace(_studentName)
                    ? null
                    : _studentName.Trim(),
                FromDate = _fromDate,
                ToDate = _toDate
            };

            var result =
                await TeacherPaymentApi.GetPaymentsAsync(request);

            _payments = result.Items ?? [];
            _totalCount = result.TotalCount;
            _totalPages = result.TotalPages;
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Failed to load teacher payments: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ApplyFilters()
    {
        _page = 1;
        await LoadPayments();
    }

    private async Task PageChanged(int page)
    {
        _page = page;
        await LoadPayments();
    }

    private async Task GeneratePayments()
    {
        try
        {
            _generating = true;

            var created =
                await TeacherPaymentApi.GenerateAsync(DateTime.Today);

            if (created > 0)
            {
                Snackbar.Add(
                    $"{created} payment cycle(s) generated successfully.",
                    Severity.Success);
            }
            else
            {
                Snackbar.Add(
                    "No new payment cycles were generated.",
                    Severity.Info);
            }

            _page = 1;
            await LoadPayments();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Failed to generate payment cycles: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _generating = false;
        }
    }

    private void OpenMarkPaidDialog(
        TeacherPaymentResponse payment)
    {
        _selectedPayment = payment;
        _paidDate = DateTime.Today;
        _transactionReference = null;
        _paymentRemarks = null;
        _showMarkPaidDialog = true;
    }

    private void CloseMarkPaidDialog()
    {
        _showMarkPaidDialog = false;
        _selectedPayment = null;
    }

    private async Task MarkPaymentPaid()
    {
        if (_selectedPayment == null)
            return;

        if (!_paidDate.HasValue)
        {
            Snackbar.Add(
                "Please select the paid date.",
                Severity.Warning);

            return;
        }

        try
        {
            _savingPayment = true;

            var request = new MarkTeacherPaymentPaidRequest
            {
                PaidDate = _paidDate.Value,
                PaymentMethodId = null,
                TransactionReference =
                    string.IsNullOrWhiteSpace(_transactionReference)
                        ? null
                        : _transactionReference.Trim(),
                Remarks =
                    string.IsNullOrWhiteSpace(_paymentRemarks)
                        ? null
                        : _paymentRemarks.Trim()
            };

            var result =
                await TeacherPaymentApi.MarkPaidAsync(
                    _selectedPayment.Id,
                    request);

            if (result == null)
            {
                Snackbar.Add(
                    "Unable to mark the payment as paid.",
                    Severity.Error);

                return;
            }

            Snackbar.Add(
                "Teacher payment marked as paid successfully.",
                Severity.Success);

            CloseMarkPaidDialog();

            await LoadPayments();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Failed to mark payment as paid: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _savingPayment = false;
        }
    }

    private async Task CancelPayment(
        TeacherPaymentResponse payment)
    {
        try
        {
            var result =
                await TeacherPaymentApi.CancelAsync(payment.Id);

            if (result == null)
            {
                Snackbar.Add(
                    "Unable to cancel the payment.",
                    Severity.Error);

                return;
            }

            Snackbar.Add(
                "Teacher payment cancelled.",
                Severity.Success);

            await LoadPayments();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Failed to cancel payment: {ex.Message}",
                Severity.Error);
        }
    }
}
