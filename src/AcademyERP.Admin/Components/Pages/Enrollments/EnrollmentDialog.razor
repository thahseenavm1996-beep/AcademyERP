@using MudBlazor
@using AcademyERP.Admin.Models
@using AcademyERP.Admin.Models.Courses
@using AcademyERP.Admin.Models.Enrollments
@using AcademyERP.Admin.Models.Lookups
@using AcademyERP.Admin.Services
@using AcademyERP.Domain.Enums

@inject StudentApiService StudentApi
@inject TeacherApiService TeacherApi
@inject CourseApiService CourseApi
@inject LookupApiService LookupApi
@inject EnrollmentApiService EnrollmentApi
@inject ISnackbar Snackbar

<MudDialog>

    <DialogContent>

        @if (_loading)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />

            <MudText Class="mt-3">
                Loading enrollment data...
            </MudText>
        }
        else
        {
            <MudForm @ref="_form">

                <MudAutocomplete T="StudentResponse"
                 Label="Student"
                 Value="_selectedStudent"
                 ValueChanged="OnStudentChanged"
                 SearchFunc="SearchStudents"
                 ToStringFunc="@(student =>
    student == null
        ? string.Empty
        : $"{student.FullName} — Admission No: {student.AdmissionNumber}")"
                 Required="true"
                 Disabled="@IsEditMode"
                 ResetValueOnEmptyText="true"
                 CoerceText="true"
                 Clearable="true"
                 Dense="true"
                 Class="mb-3" />

                <MudSelect T="Guid" Label="Course" @bind-Value="_model.CourseId" Required="true" Disabled="@IsEditMode"
                           Class="mb-3">

                    @foreach (var course in _courses)
                    {
                        <MudSelectItem T="Guid" Value="@course.Id">
                            @course.CourseName
                        </MudSelectItem>
                    }

                </MudSelect>

                <MudSelect T="Guid?" Label="Teacher" @bind-Value="_model.TeacherId" Clearable="true" Class="mb-3">

                    @foreach (var teacher in _teachers)
                    {
                        <MudSelectItem T="Guid?" Value="@((Guid?)teacher.Id)">
                            @teacher.FullName
                        </MudSelectItem>
                    }

                </MudSelect>

               <MudText Typo="Typo.h6" Class="mt-4 mb-2">
    Class Schedule
</MudText>


<MudText Typo="Typo.h6" Class="mt-4 mb-2">
    Class Schedule
</MudText>

<MudPaper Class="pa-3 mb-3" Outlined="true">

    <MudText Typo="Typo.subtitle2" Class="mb-2">
        Select Class Days
    </MudText>

    <MudCheckBox T="bool"
                 Value="_allDaysSelected"
                 ValueChanged="OnAllDaysChanged"
                 Label="All Days (Monday - Saturday)"
                 Color="Color.Primary"
                 Disabled="@AreAllDaysAdded"
                 Class="mb-2" />

    <MudGrid>
        @foreach (var day in _classDays)
        {
            <MudItem xs="6" sm="4">
                <MudCheckBox T="bool"
                             Value="@IsDaySelected(day)"
                             ValueChanged="@(value => ToggleDay(day, value))"
                             Label="@day.ToString()"
                             Color="Color.Primary"
                             Disabled="@IsDayAlreadyAdded(day)" />
            </MudItem>
        }
    </MudGrid>

</MudPaper>

<MudSelect T="Guid"
           Label="Time Slot"
           @bind-Value="_selectedTimeSlotId"
           Class="mb-3">

    @foreach (var slot in _timeSlots)
    {
        <MudSelectItem T="Guid" Value="@slot.Id">
            @slot.Name
        </MudSelectItem>
    }

</MudSelect>

<MudSelect T="Guid"
           Label="Duration"
           @bind-Value="_selectedDurationId"
           Class="mb-3">

    @foreach (var duration in _classDurations)
    {
        <MudSelectItem T="Guid" Value="@duration.Id">
            @duration.Name
        </MudSelectItem>
    }

</MudSelect>

<MudButton Color="Color.Primary"
           Variant="Variant.Filled"
           FullWidth="true"
           OnClick="AddSelectedDays"
           Disabled="@(!_selectedDays.Any())">

    ADD SELECTED DAYS

</MudButton>
@if (_schedules.Count > 0)
{
    <MudTable Items="_schedules" Class="mt-4">

        <HeaderContent>
            <MudTh>Day</MudTh>
            <MudTh>Time</MudTh>
            <MudTh>Duration</MudTh>
            <MudTh></MudTh>
        </HeaderContent>

        <RowTemplate>

            <MudTd>
                @context.DayOfWeek
            </MudTd>


            <MudTd>
    @_timeSlots.FirstOrDefault(x => x.Id == context.TimeSlotId)?.Name
</MudTd>


           <MudTd>
    @_classDurations.FirstOrDefault(x => x.Id == context.ClassDurationId)?.Name
</MudTd>


            <MudTd>

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => RemoveSchedule(context))" />

            </MudTd>

        </RowTemplate>

    </MudTable>
}

               

                <MudDatePicker Label="Start Date" @bind-Date="_startDate" Required="true" Class="mb-3" />

                <MudDatePicker Label="End Date" @bind-Date="_endDate" Clearable="true" Class="mb-3" />

                <MudNumericField T="decimal" Label="Monthly Fee" @bind-Value="_model.MonthlyFee" Min="0" Class="mb-3" />

                <MudNumericField T="decimal" Label="Teacher Payment Amount" @bind-Value="_model.TeacherPaymentAmount" Min="0" Class="mb-3" />

                <MudNumericField T="decimal" Label="Scholarship Amount" @bind-Value="_model.ScholarshipAmount" Min="0"
                                 Class="mb-3" />

                @if (_model.ScholarshipAmount > 0)
                {
                    <MudTextField T="string" Label="Scholarship Reason" @bind-Value="_model.ScholarshipReason" Class="mb-3" />
                }

                <MudNumericField T="decimal" Label="Discount Amount" @bind-Value="_model.DiscountAmount" Min="0"
                                 Class="mb-3" />

                @if (_model.DiscountAmount > 0)
                {
                    <MudTextField T="string" Label="Discount Reason" @bind-Value="_model.DiscountReason" Class="mb-3" />
                }

                <MudText Typo="Typo.subtitle1" Class="mb-3">
                    Final Monthly Fee:
                    @FinalMonthlyFee.ToString("0.00")
                </MudText>

                @if (IsEditMode)
                {
                    <MudSelect T="EnrollmentStatus" Label="Status" @bind-Value="_status" Class="mb-3">

                        @foreach (EnrollmentStatus status in
                            Enum.GetValues(typeof(EnrollmentStatus)))
                        {
                            <MudSelectItem T="EnrollmentStatus" Value="@status">
                                @status
                            </MudSelectItem>
                        }

                    </MudSelect>
                }

                <MudTextField T="string" Label="Remarks" @bind-Value="_model.Remarks" Lines="3" Class="mb-3" />

            </MudForm>
        }

    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel" Disabled="@_saving">
            Cancel
        </MudButton>

        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="@(_loading || _saving)">

            @if (_saving)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }

            Save

        </MudButton>

    </DialogActions>

</MudDialog>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public EnrollmentResponse? Enrollment { get; set; }

    private MudForm? _form;
private StudentResponse? _selectedStudent;
    private CreateEnrollmentRequest _model = new();

    private List<TeacherResponse> _teachers = new();

    private List<CourseResponse> _courses = new();

    private List<TimeSlotResponse> _timeSlots = new();

    private List<ClassDurationResponse> _classDurations = new();
   private List<EnrollmentScheduleRequest> _schedules = new();

private readonly List<DayOfWeek> _classDays = new()
{
    DayOfWeek.Monday,
    DayOfWeek.Tuesday,
    DayOfWeek.Wednesday,
    DayOfWeek.Thursday,
    DayOfWeek.Friday,
    DayOfWeek.Saturday
};

private HashSet<DayOfWeek> _selectedDays = new();

private bool _allDaysSelected;

private Guid _selectedTimeSlotId;

private Guid _selectedDurationId;

    private DateTime? _startDate = DateTime.Today;

    private DateTime? _endDate;

    private EnrollmentStatus _status = EnrollmentStatus.Active;

    private bool _loading = true;

    private bool _saving;

    private bool IsEditMode => Enrollment != null;

    private decimal FinalMonthlyFee =>
        Math.Max(
            0,
            _model.MonthlyFee
            - _model.ScholarshipAmount
            - _model.DiscountAmount);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loading = true;

           

            var teacherRequest = new TeacherQueryRequest
            {
                Page = 1,
                PageSize = 100
            };

           

            var teachersResult =
                await TeacherApi.GetTeachersAsync(teacherRequest);

            _courses =
                await CourseApi.GetAllAsync();

            _timeSlots =
                await LookupApi.GetTimeSlotsAsync();

            _classDurations =
                await LookupApi.GetClassDurationsAsync();
                


            if (teachersResult != null)
                _teachers = teachersResult.Data.Items ?? new();

            if (Enrollment != null)
            {
                _model.StudentId =
                    Enrollment.StudentId;
                    _selectedStudent = await StudentApi.GetStudentAsync(Enrollment.StudentId);

                _model.CourseId =
                    Enrollment.CourseId;

                _model.TeacherId =
                    Enrollment.TeacherId;

               

                _model.StartDate =
                    Enrollment.StartDate;

                _model.EndDate =
                    Enrollment.EndDate;

                _model.MonthlyFee =
                    Enrollment.MonthlyFee;

                _model.ScholarshipAmount =
                    Enrollment.ScholarshipAmount;

                _model.ScholarshipReason =
                    Enrollment.ScholarshipReason;

                _model.DiscountAmount =
                    Enrollment.DiscountAmount;

                _model.DiscountReason =
                    Enrollment.DiscountReason;

                _model.Remarks =
                    Enrollment.Remarks;

                _startDate =
                    Enrollment.StartDate;

                _endDate =
                    Enrollment.EndDate;

                _status =
                    Enrollment.Status;
                    _schedules = Enrollment.Schedules
    .Select(x => new EnrollmentScheduleRequest
    {
        DayOfWeek = x.DayOfWeek,
        TimeSlotId = x.TimeSlotId,
        ClassDurationId = x.ClassDurationId
    })
    .ToList();
    
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to load enrollment data: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
       if (Enrollment != null)
{
    Console.WriteLine(
        $"Schedules Count: {Enrollment.Schedules.Count}");

    foreach(var s in Enrollment.Schedules)
    {
        Console.WriteLine(
            $"{s.DayOfWeek} {s.TimeSlotId} {s.ClassDurationId}");
    }
}
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private async Task Save()
    {
        await _form!.ValidateAsync();

        if (!_form.IsValid)
            return;

        if (!_startDate.HasValue)
        {
            Snackbar.Add(
                "Start date is required.",
                Severity.Warning);

            return;
        }

        if (_model.StudentId == Guid.Empty)
        {
            Snackbar.Add(
                "Please select a student.",
                Severity.Warning);

            return;
        }

        if (_model.CourseId == Guid.Empty)
        {
            Snackbar.Add(
                "Please select a course.",
                Severity.Warning);

            return;
        }

       

        if (_model.ScholarshipAmount
            + _model.DiscountAmount
            > _model.MonthlyFee)
        {
            Snackbar.Add(
                "Scholarship and discount cannot exceed the monthly fee.",
                Severity.Warning);

            return;
        }

        try
        {
            _saving = true;

            _model.StartDate =
                _startDate.Value;

            _model.EndDate =
                _endDate;
                _model.Schedules = _schedules;

            if (Enrollment == null)
            {
                await EnrollmentApi.CreateAsync(
                    _model);

                Snackbar.Add(
                    "Enrollment created successfully.",
                    Severity.Success);
            }
            else
            {
                var request =
                    new UpdateEnrollmentRequest
                    {
                        TeacherId =
                            _model.TeacherId,

                        

                        StartDate =
                            _startDate.Value,

                        EndDate =
                            _endDate,

                        MonthlyFee =
                            _model.MonthlyFee,
                            Schedules = _schedules,

                        ScholarshipAmount =
                            _model.ScholarshipAmount,

                        ScholarshipReason =
                            _model.ScholarshipReason,

                        DiscountAmount =
                            _model.DiscountAmount,

                        DiscountReason =
                            _model.DiscountReason,

                        Status =
                            _status,

                        Remarks =
                            _model.Remarks
                    };

                await EnrollmentApi.UpdateAsync(
                    Enrollment.Id,
                    request);

                Snackbar.Add(
                    "Enrollment updated successfully.",
                    Severity.Success);
            }

            MudDialog.Close(
                DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to save enrollment: {ex.Message}",
                Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
 private void OnAllDaysChanged(bool value)
{
    _allDaysSelected = value;

    if (value)
    {
        _selectedDays = _classDays
            .Where(day => !IsDayAlreadyAdded(day))
            .ToHashSet();
    }
    else
    {
        _selectedDays.Clear();
    }
}

private bool IsDaySelected(DayOfWeek day)
{
    return _selectedDays.Contains(day);
}

private void ToggleDay(DayOfWeek day, bool selected)
{
    if (IsDayAlreadyAdded(day))
        return;

    if (selected)
        _selectedDays.Add(day);
    else
        _selectedDays.Remove(day);

    _allDaysSelected =
        _classDays
            .Where(day => !IsDayAlreadyAdded(day))
            .All(day => _selectedDays.Contains(day));
}

private bool IsDayAlreadyAdded(DayOfWeek day)
{
    return _schedules.Any(x => x.DayOfWeek == day);
}

private bool AreAllDaysAdded =>
    _classDays.All(IsDayAlreadyAdded);

private void AddSelectedDays()
{
    if (!_selectedDays.Any())
    {
        Snackbar.Add(
            "Please select at least one class day.",
            Severity.Warning);

        return;
    }

    if (_selectedTimeSlotId == Guid.Empty)
    {
        Snackbar.Add(
            "Please select time slot.",
            Severity.Warning);

        return;
    }

    if (_selectedDurationId == Guid.Empty)
    {
        Snackbar.Add(
            "Please select duration.",
            Severity.Warning);

        return;
    }

    foreach (var day in _selectedDays.OrderBy(x => x))
    {
        if (IsDayAlreadyAdded(day))
            continue;

        _schedules.Add(
            new EnrollmentScheduleRequest
            {
                DayOfWeek = day,
                TimeSlotId = _selectedTimeSlotId,
                ClassDurationId = _selectedDurationId
            });
    }

    _selectedDays.Clear();
    _allDaysSelected = false;

    _selectedTimeSlotId = Guid.Empty;
    _selectedDurationId = Guid.Empty;
}

private void RemoveSchedule(
    EnrollmentScheduleRequest schedule)
{
    _schedules.Remove(schedule);
}

private async Task<IEnumerable<StudentResponse>> SearchStudents(
    string value,
    CancellationToken cancellationToken)
{
    if (string.IsNullOrWhiteSpace(value))
        return Enumerable.Empty<StudentResponse>();

    var request = new StudentQueryRequest
    {
        Page = 1,
        PageSize = 20,
        Search = value.Trim()
    };

    var result = await StudentApi.GetStudentsAsync(request);

    if (result?.Data?.Items is null)
        return Enumerable.Empty<StudentResponse>();

    return result.Data.Items;
}


private void OnStudentChanged(StudentResponse? student)
{
    _selectedStudent = student;
    _model.StudentId = student?.Id ?? Guid.Empty;
}
}