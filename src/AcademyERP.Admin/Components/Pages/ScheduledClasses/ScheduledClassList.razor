@page "/scheduledclasses"

@using AcademyERP.Application.DTOs.ScheduledClasses
@using AcademyERP.Admin.Services
@using MudBlazor
@using AcademyERP.Admin.Models.Attendance
@using AcademyERP.Domain.Enums

@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ScheduledClassApiService ScheduledClassApi
@inject AttendanceApiService AttendanceApi

@using Microsoft.AspNetCore.Components
<PageTitle>Scheduled Classes</PageTitle>

<MudButton
    Variant="Variant.Filled"
    Color="Color.Primary"
    StartIcon="@Icons.Material.Filled.Refresh">

    Generate Classes

</MudButton>

<MudGrid Class="mb-4">

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="border-left:5px solid #1976d2;">
            <MudText Typo="Typo.subtitle2">
                Total Classes
            </MudText>

            <MudText Typo="Typo.h4">
                @_classes.Count
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="border-left:5px solid #2e7d32;">
            <MudText Typo="Typo.subtitle2">
                Scheduled
            </MudText>

            <MudText Typo="Typo.h4">
                @_classes.Count(x => x.Status == "Scheduled")
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="border-left:5px solid #ed6c02;">
            <MudText Typo="Typo.subtitle2">
                This Week
            </MudText>

            <MudText Typo="Typo.h4">
                @_classes.Count(x =>
                    x.ClassDate >= DateOnly.FromDateTime(DateTime.Today) &&
                    x.ClassDate <= DateOnly.FromDateTime(DateTime.Today.AddDays(7)))
            </MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudPaper Class="pa-4" Style="border-left:5px solid #9c27b0;">
            <MudText Typo="Typo.subtitle2">
                Today's Classes
            </MudText>

            <MudText Typo="Typo.h4">
                @_classes.Count(x =>
                    x.ClassDate == DateOnly.FromDateTime(DateTime.Today))
            </MudText>
        </MudPaper>
    </MudItem>

</MudGrid>

<MudPaper Class="pa-4">

    <MudTextField T="string"
                  Label="Search Student"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="mb-4"
                  @bind-Value="_searchText" />

    <MudTable Items="@FilteredClasses"
              Hover="true"
              Dense="true"
              Striped="true">

        <HeaderContent>
            <MudTh>Date</MudTh>
            <MudTh>Student</MudTh>
            <MudTh>Teacher</MudTh>
            <MudTh>Course</MudTh>
            <MudTh>Time</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>

        <RowTemplate>

            <MudTd>
                @context.ClassDate.ToString("dd MMM yyyy")
            </MudTd>

            <MudTd>
                @context.StudentName
            </MudTd>

            <MudTd>
                @context.TeacherName
            </MudTd>

            <MudTd>
                @context.CourseName
            </MudTd>

            <MudTd>
                @($"{context.StartTime:hh\\:mm} - {context.EndTime:hh\\:mm}")
            </MudTd>

            <MudTd>

                @if (context.Status == "Scheduled")
                {
                    <MudChip T="string"
                             Color="Color.Primary"
                             Size="Size.Small">
                        @context.Status
                    </MudChip>
                }
                else if (context.Status == "Completed")
                {
                    <MudChip T="string"
                             Color="Color.Success"
                             Size="Size.Small">
                        @context.Status
                    </MudChip>
                }
                else if (context.Status == "Cancelled")
                {
                    <MudChip T="string"
                             Color="Color.Error"
                             Size="Size.Small">
                        @context.Status
                    </MudChip>
                }
                else
                {
                    <MudChip T="string"
                             Color="Color.Default"
                             Size="Size.Small">
                        @context.Status
                    </MudChip>
                }

            </MudTd>
<MudIconButton
    Icon="@Icons.Material.Filled.Visibility"
    Color="Color.Info"
    Size="Size.Small"
    OnClick="@(() => OpenViewDialog(context))" />

<MudIconButton
    Icon="@Icons.Material.Filled.Edit"
    Color="Color.Primary"
    Size="Size.Small"
    OnClick="@(() => OpenEditDialog(context))" />
        </RowTemplate>

    </MudTable>

</MudPaper>

@code
{
    private List<ScheduledClassResponse> _classes = new();
    private HashSet<Guid> _missedClassIds = new();

    private string _searchText = "";

    [SupplyParameterFromQuery(Name = "filter")]
private string? Filter { get; set; }

    private IEnumerable<ScheduledClassResponse> FilteredClasses
{
    get
    {
        var today = DateOnly.FromDateTime(DateTime.Today);

        IEnumerable<ScheduledClassResponse> query = _classes;

        switch (Filter?.ToLowerInvariant())
        {
            case "today":
                query = query.Where(x =>
                    x.ClassDate == today);
                break;

            case "completed":
                query = query.Where(x =>
                    x.ClassDate == today &&
                    x.Status == "Completed");
                break;

            case "upcoming":
                query = query.Where(x =>
                    x.ClassDate == today &&
                    x.Status == "Scheduled");
                break;

                case "missed":
    query = query.Where(x =>
        x.ClassDate == today &&
        _missedClassIds.Contains(x.Id));
    break;
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            query = query.Where(x =>
                x.StudentName.Contains(
                    _searchText,
                    StringComparison.OrdinalIgnoreCase));
        }

        return query;
    }
}

    protected override async Task OnInitializedAsync()
{
    var result = await ScheduledClassApi.GetAllAsync();

    _classes = result ?? new List<ScheduledClassResponse>();

    var today = DateTime.Today;

    var attendance = await AttendanceApi.GetHistoryAsync(
        new AttendanceQueryRequest
        {
            FromDate = today,
            ToDate = today,
            Status = AttendanceStatus.Absent,
            Page = 1,
            PageSize = 1000
        });

    _missedClassIds = attendance.Items
        .Select(x => x.ScheduledClassId)
        .ToHashSet();
}
  private async Task OpenViewDialog(
    ScheduledClassResponse scheduledClass)
{
    var parameters =
        new DialogParameters
        {
            {
                "Class",
                scheduledClass
            }
        };


    await DialogService.ShowAsync<ScheduledClassViewDialog>(
        "Scheduled Class Details",
        parameters);
}

private async Task OpenEditDialog(
    ScheduledClassResponse scheduledClass)
{
    var parameters =
        new DialogParameters
        {
            {
                "Class",
                scheduledClass
            }
        };


    var dialog =
        await DialogService.ShowAsync<ScheduledClassEditDialog>(
            "Edit Scheduled Class",
            parameters);


    var result = await dialog.Result;


    if (!result.Canceled &&
        result.Data is UpdateScheduledClassRequest request)
    {
        await ScheduledClassApi.UpdateAsync(
            scheduledClass.Id,
            request);


        Snackbar.Add(
            "Scheduled class updated successfully.",
            Severity.Success);


        var classes =
            await ScheduledClassApi.GetAllAsync();

        _classes = classes;
        StateHasChanged();
    }
}
}