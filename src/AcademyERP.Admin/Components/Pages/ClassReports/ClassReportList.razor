@page "/classreports"

@using MudBlazor
@using AcademyERP.Admin.Models.ClassReports
@using AcademyERP.Admin.Services

@inject ClassReportApiService ClassReportApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Class Reports</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Class Reports
</MudText>

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenCreateDialog">
    Create Class Report
</MudButton>

<MudPaper Class="pa-4 mt-4">

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else if (_reports.Count == 0)
    {
        <MudText>No class reports found.</MudText>
    }
    else
    {
        <MudTextField T="string"
                      Label="Search Student"
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="mb-4"
                      @bind-Value="_searchText" />

        <MudTable Items="FilteredReports"
                  Hover="true"
                  Dense="true"
                  Striped="true">

            <HeaderContent>
                <MudTh>Date</MudTh>
                <MudTh>Student</MudTh>
                <MudTh>Teacher</MudTh>
                <MudTh>Course</MudTh>
                <MudTh>Attendance</MudTh>
                <MudTh>Performance</MudTh>
                <MudTh>Behaviour</MudTh>
                <MudTh>Outcome</MudTh>
                <MudTh>Duration</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>

            <RowTemplate>

                <MudTd>
                    @context.ReportDate.ToString("dd MMM yyyy")
                </MudTd>

                <MudTd>
                    @context.StudentName
                </MudTd>

                <MudTd>
                    @context.TeacherName
                </MudTd>

                <MudTd>
                    @context.CourseName
                </MudTd>

                <MudTd>
                    <MudChip T="string"
                             Color="Color.Success"
                             Size="Size.Small">
                        @context.AttendanceStatus
                    </MudChip>
                </MudTd>

                <MudTd>
                    <MudChip T="string"
                             Color="Color.Warning"
                             Size="Size.Small">
                        @context.PerformanceRating
                    </MudChip>
                </MudTd>

                <MudTd>
                    <MudChip T="string"
                             Color="Color.Secondary"
                             Size="Size.Small">
                        @context.BehaviourRating
                    </MudChip>
                </MudTd>

                <MudTd>
                    <MudChip T="string"
                             Color="Color.Info"
                             Size="Size.Small">
                        @context.ClassOutcome
                    </MudChip>
                </MudTd>

                <MudTd>
                    @context.ActualDurationMinutes min
                </MudTd>

                <MudTd>

                    <MudIconButton
                        Icon="@Icons.Material.Filled.Delete"
                        Color="Color.Error"
                        Size="Size.Small"
                        OnClick="@(() => DeleteReport(context.Id))" />

                </MudTd>

            </RowTemplate>

        </MudTable>
    }

</MudPaper>

@code {

    private List<ClassReportResponse> _reports = new();

    private bool _loading = true;

    private string _searchText = string.Empty;

    private IEnumerable<ClassReportResponse> FilteredReports =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _reports
            : _reports.Where(x =>
                x.StudentName.Contains(
                    _searchText,
                    StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        try
        {
            _loading = true;

            var request = new ClassReportQueryRequest
            {
                Page = 1,
                PageSize = 100
            };

            var result =
                await ClassReportApi.GetAllAsync(request);

            _reports =
                result?.Items?.ToList()
                ?? new List<ClassReportResponse>();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

   
private async Task OpenCreateDialog()
{
    var parameters =
        new DialogParameters<ClassReportDialog>
        {
            {
                x => x.Model,
                new CreateClassReportRequest()
            }
        };

    var dialog =
        await DialogService.ShowAsync<ClassReportDialog>(
            "Create Class Report",
            parameters);

    var result = await dialog.Result;

    if (result is not null &&
        !result.Canceled &&
        result.Data is CreateClassReportRequest request)
    {
        try
        {
            await ClassReportApi.CreateAsync(request);

            Snackbar.Add(
                "Class report created successfully.",
                Severity.Success);

            await LoadReports();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
    }
}

    private async Task DeleteReport(Guid id)
    {
        await ClassReportApi.DeleteAsync(id);

        Snackbar.Add(
            "Class report deleted successfully.",
            Severity.Success);

        await LoadReports();
    }

}