@page "/teachingschedules"

@using AcademyERP.Admin.Models
@using AcademyERP.Admin.Services
@using MudBlazor

@inject TeachingScheduleApiService TeachingScheduleApi
@inject IDialogService DialogService

<PageTitle>Teaching Schedule</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Teaching Schedule
</MudText>

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.Add"
           OnClick="OpenCreateDialog">

    Create Schedule

</MudButton>

<MudPaper Class="pa-4 mt-4">

    <MudTable T="TeachingScheduleResponse"
              Dense="true"
              Items="_schedules">

        <HeaderContent>

            <MudTh>Student</MudTh>
            <MudTh>Teacher</MudTh>
            <MudTh>Course</MudTh>
            <MudTh>Day</MudTh>
            <MudTh>Time</MudTh>

        </HeaderContent>

        <RowTemplate>

            <MudTd>@context.StudentName</MudTd>
            <MudTd>@context.TeacherName</MudTd>
            <MudTd>@context.CourseName</MudTd>
            <MudTd>@context.DayOfWeek</MudTd>

            <MudTd>
                @context.StartTime.ToString("hh\\:mm")
                -
                @context.EndTime.ToString("hh\\:mm")
            </MudTd>

        </RowTemplate>

    </MudTable>

</MudPaper>

@code {

    private List<TeachingScheduleResponse> _schedules = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSchedules();
    }

    private async Task LoadSchedules()
    {
        _schedules =
            await TeachingScheduleApi.GetAllAsync()
            ?? new();
    }

    private async Task OpenCreateDialog()
    {
        var dialog =
            await DialogService.ShowAsync<TeachingScheduleDialog>(
                "Create Teaching Schedule");

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadSchedules();
            StateHasChanged();
        }
    }
}