@page "/parent/attendance"
@layout ParentLayout

@using AcademyERP.Admin.Models.ParentPortal
@using AcademyERP.Admin.Services

@inject ParentPortalApiService ParentPortalApi

<PageTitle>Attendance</PageTitle>

<MudText Typo="Typo.h4">
    Attendance
</MudText>

<MudText Typo="Typo.body2"
         Color="Color.Secondary"
         Class="mb-5">
    Monitor your children's class attendance.
</MudText>

@if (_loading && _attendance == null)
{
    <MudProgressLinear Indeterminate="true" />
}
else if (_attendance == null)
{
    <MudAlert Severity="Severity.Error">
        Unable to load attendance information.
    </MudAlert>
}
else
{
    <MudGrid Spacing="3" Class="mb-5">

        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary">
                        Total Classes
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @_attendance.Summary.Total
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary">
                        Present
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @_attendance.Summary.Present
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary">
                        Absent
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @_attendance.Summary.Absent
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

        <MudItem xs="12" sm="6" md="3">
            <MudCard>
                <MudCardContent>
                    <MudText Typo="Typo.body2"
                             Color="Color.Secondary">
                        Attendance Rate
                    </MudText>
                    <MudText Typo="Typo.h4">
                        @_attendance.Summary.AttendanceRate.ToString("0.##")%
                    </MudText>
                </MudCardContent>
            </MudCard>
        </MudItem>

    </MudGrid>

    <MudPaper Class="pa-4 mb-5">

        <MudGrid>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="Guid?"
                           Label="Child"
                           @bind-Value="_studentId"
                           Variant="Variant.Outlined"
                           Clearable="true">

                    <MudSelectItem T="Guid?"
                                   Value="@((Guid?)null)">
                        All Children
                    </MudSelectItem>

                    @foreach (var child in _children)
                    {
                        <MudSelectItem T="Guid?"
                                       Value="@((Guid?)child.StudentId)">
                            @child.StudentName
                        </MudSelectItem>
                    }

                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string"
                           Label="Status"
                           @bind-Value="_status"
                           Variant="Variant.Outlined"
                           Clearable="true">

                    <MudSelectItem Value="@("Present")">Present</MudSelectItem>
                    <MudSelectItem Value="@("Absent")">Absent</MudSelectItem>
                    <MudSelectItem Value="@("Late")">Late</MudSelectItem>
                    <MudSelectItem Value="@("Leave")">Leave</MudSelectItem>

                </MudSelect>
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="From Date"
                               @bind-Date="_fromDate"
                               Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12" sm="6" md="3">
                <MudDatePicker Label="To Date"
                               @bind-Date="_toDate"
                               Variant="Variant.Outlined" />
            </MudItem>

            <MudItem xs="12">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.FilterAlt"
                           OnClick="LoadAttendance">
                    Apply Filters
                </MudButton>
            </MudItem>

        </MudGrid>

    </MudPaper>

    @if (!_attendance.Records.Any())
    {
        <MudPaper Class="pa-8 text-center">
            <MudIcon Icon="@Icons.Material.Filled.EventAvailable"
                     Size="Size.Large"
                     Color="Color.Primary" />

            <MudText Typo="Typo.h6" Class="mt-3">
                No attendance records found
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudPaper Class="attendance-table-container"
          Elevation="0"
          Outlined="true">

    <MudTable Items="_attendance.Records"
              Hover="true"
              Dense="false"
              Striped="false"
              Bordered="false"
              Breakpoint="Breakpoint.None"
              Class="modern-attendance-table">

        <HeaderContent>

            <MudTh Class="attendance-date-column">
                Date
            </MudTh>

            <MudTh>
                Student
            </MudTh>

            <MudTh>
                Course
            </MudTh>

            <MudTh>
                Teacher
            </MudTh>

            <MudTh>
                Time
            </MudTh>

            <MudTh>
                Status
            </MudTh>

            <MudTh>
                Remarks
            </MudTh>

        </HeaderContent>

        <RowTemplate Context="item">

            <MudTd DataLabel="Date"
                   Class="attendance-date-column">

                <MudText Typo="Typo.body2"
                         Class="attendance-date">
                    @item.ClassDate
                </MudText>

            </MudTd>

            <MudTd DataLabel="Student">

                <MudText Typo="Typo.body2"
                         Class="attendance-student">
                    @item.StudentName
                </MudText>

            </MudTd>

            <MudTd DataLabel="Course">

                <MudText Typo="Typo.body2"
                         Class="attendance-course">
                    @item.CourseName
                </MudText>

            </MudTd>

            <MudTd DataLabel="Teacher">

                <MudText Typo="Typo.body2">
                    @item.TeacherName
                </MudText>

            </MudTd>

            <MudTd DataLabel="Time">

                <MudText Typo="Typo.body2"
                         Class="attendance-time">
                    @item.StartTime
                </MudText>

            </MudTd>

            <MudTd DataLabel="Status">

                <MudChip T="string"
                         Size="Size.Small"
                         Variant="Variant.Outlined"
                         Color="@GetStatusColor(item.Status)">
                    @item.Status
                </MudChip>

            </MudTd>

            <MudTd DataLabel="Remarks">

                <MudText Typo="Typo.body2"
                         Class="attendance-remarks">
                    @(string.IsNullOrWhiteSpace(item.Remarks)
                        ? "—"
                        : item.Remarks)
                </MudText>

            </MudTd>

        </RowTemplate>

    </MudTable>

</MudPaper>
    }
}
<style>
    .attendance-table-container {
        overflow-x: auto;
        border-radius: 12px;
    }

    .modern-attendance-table {
        min-width: 850px;
    }

    .modern-attendance-table .mud-table-head {
        background-color: #f8fafc;
    }

    .modern-attendance-table .mud-table-head .mud-table-cell {
        font-weight: 600;
        font-size: 0.78rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        white-space: nowrap;
        padding: 14px 16px;
    }

    .modern-attendance-table .mud-table-body .mud-table-cell {
        padding: 16px;
        vertical-align: middle;
    }

    .modern-attendance-table .mud-table-row {
        transition: background-color 0.15s ease;
    }

    .modern-attendance-table .mud-table-row:hover {
        background-color: #f8fafc;
    }

    .attendance-date-column {
        min-width: 120px;
        white-space: nowrap;
    }

    .attendance-date {
        font-weight: 600;
        white-space: nowrap;
    }

    .attendance-student {
        font-weight: 600;
    }

    .attendance-course {
        font-weight: 500;
    }

    .attendance-time {
        white-space: nowrap;
    }

    .attendance-remarks {
        max-width: 220px;
    }

    @@media (max-width: 800px) {
        .modern-attendance-table {
            min-width: 800px;
        }

        .modern-attendance-table .mud-table-head .mud-table-cell,
        .modern-attendance-table .mud-table-body .mud-table-cell {
            padding: 12px;
        }
    }

    @@media (max-width: 600px) {
        .attendance-table-container {
            margin-left: -4px;
            margin-right: -4px;
            border-radius: 10px;
        }

        .modern-attendance-table {
            min-width: 800px;
        }
    }
</style>
@code {
    private List<ParentChildSummaryDto> _children = [];
    private ParentAttendanceResponse? _attendance;

    private Guid? _studentId;
    private string? _status;
    private DateTime? _fromDate;
    private DateTime? _toDate;

    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _children =
                await ParentPortalApi.GetChildrenAsync() ?? [];

            await LoadAttendance();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadAttendance()
    {
        _loading = true;

        try
        {
            _attendance =
                await ParentPortalApi.GetAttendanceAsync(
                    _studentId,
                    _status,
                    _fromDate.HasValue
                        ? DateOnly.FromDateTime(_fromDate.Value)
                        : null,
                    _toDate.HasValue
                        ? DateOnly.FromDateTime(_toDate.Value)
                        : null);
        }
        finally
        {
            _loading = false;
        }
    }

    private static Color GetStatusColor(string status)
    {
        return status switch
        {
            "Present" => Color.Success,
            "Late" => Color.Warning,
            "Absent" => Color.Error,
            "Leave" => Color.Info,
            _ => Color.Default
        };
    }
}
