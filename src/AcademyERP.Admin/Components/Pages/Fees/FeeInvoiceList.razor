@page "/fees"

@using AcademyERP.Admin.Models
@using AcademyERP.Admin.Models.Courses
@using AcademyERP.Admin.Services
@using MudBlazor
@using AcademyERP.Domain.Enums
@using ClosedXML.Excel
@inject IJSRuntime JS

@inject FeeInvoiceApiService FeeInvoiceApi
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject CourseApiService CourseApi
@inject TeacherApiService TeacherApi

<PageTitle>Fees</PageTitle>

<MudPaper Class="pa-4">

    <MudText Typo="Typo.h5" Class="mb-4">
        Finance - Fees
    </MudText>

    <MudTabs Rounded="true"
             Border="true"
             Elevation="0">

        <MudTabPanel Text="Invoices">

            <MudStack Row="true"
          Justify="Justify.SpaceBetween"
          AlignItems="AlignItems.Center"
          Class="fee-invoice-header">

                <MudText Typo="Typo.h6">
                    Generated Fee Invoices
                </MudText>

              <MudStack Row="true"
          Spacing="2"
          Class="fee-invoice-actions"
          Wrap="Wrap.Wrap">

    <MudButton Variant="Variant.Outlined"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Autorenew"
               OnClick="@GenerateDueFees">
        Generate All Fees
    </MudButton>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Success"
               StartIcon="@Icons.Material.Filled.TableView"
               OnClick="@DownloadExcelAsync">
        Download Excel
    </MudButton>
<MudButton Variant="Variant.Outlined"
           Color="Color.Error"
           StartIcon="@Icons.Material.Filled.PictureAsPdf"
           OnClick="@DownloadPdfAsync">
    Download PDF
</MudButton>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="@CreateInvoice">
        Create Invoice
    </MudButton>

</MudStack>

            </MudStack>

        <MudGrid Class="mb-2">

    <MudItem xs="12" md="4">
        <MudTextField T="string"
                      Label="Student Name"
                      Placeholder="Search student..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      @bind-Value="_studentName"
                      Immediate="false" />
    </MudItem>

    <MudItem xs="12" md="4">
        <MudTextField T="string"
                      Label="Teacher Name"
                      Placeholder="Search teacher..."
                      Variant="Variant.Outlined"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.PersonSearch"
                      @bind-Value="_teacherName" />
    </MudItem>

    <MudItem xs="12" md="4">
        <MudSelect T="Guid?"
                   Label="Teacher"
                   Variant="Variant.Outlined"
                   Clearable="true"
                   @bind-Value="_teacherId">

            @foreach (var teacher in _teachers)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)teacher.Id)">
                    @teacher.FullName
                </MudSelectItem>
            }

        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="Guid?"
                   Label="Course"
                   Variant="Variant.Outlined"
                   Clearable="true"
                   @bind-Value="_courseId">

            @foreach (var course in _courses)
            {
                <MudSelectItem T="Guid?" Value="@((Guid?)course.Id)">
                    @course.CourseName
                </MudSelectItem>
            }

        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="string"
                   Label="Gender"
                   Variant="Variant.Outlined"
                   Clearable="true"
                   @bind-Value="_genderFilter">

            <MudSelectItem T="string" Value="@("Male")">
                Boys
            </MudSelectItem>

            <MudSelectItem T="string" Value="@("Female")">
                Girls
            </MudSelectItem>

        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6" md="3">
        <MudSelect T="FeeStatus?"
                   Label="Payment Status"
                   Variant="Variant.Outlined"
                   Clearable="true"
                   @bind-Value="_statusFilter">

            <MudSelectItem T="FeeStatus?" Value="@((FeeStatus?)1)">
                Pending
            </MudSelectItem>

            <MudSelectItem T="FeeStatus?" Value="@((FeeStatus?)2)">
                Partially Paid
            </MudSelectItem>

            <MudSelectItem T="FeeStatus?" Value="@((FeeStatus?)3)">
                Paid
            </MudSelectItem>

            <MudSelectItem T="FeeStatus?" Value="@((FeeStatus?)4)">
                Overdue
            </MudSelectItem>

        </MudSelect>
    </MudItem>

    <MudItem xs="12" sm="6" md="3" Class="d-flex align-center">
        <MudStack Row="true"
                  Spacing="1"
                  Class="w-100">

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Search"
                       OnClick="ApplyFilters">
                Search
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Clear"
                       OnClick="ClearFilters">
                Clear
            </MudButton>

        </MudStack>
    </MudItem>

</MudGrid>

            <MudTable Items="FilteredInvoices"
                      Hover="true"
                      Dense="true"
                      Striped="true">

                <HeaderContent>

                    <MudTh>Invoice No</MudTh>
                    <MudTh>Student</MudTh>
                    <MudTh>Section</MudTh>
                    <MudTh>Course</MudTh>
                    <MudTh>Amount</MudTh>
                    <MudTh>Paid</MudTh>
                    <MudTh>Balance</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Invoice Date</MudTh>
                    <MudTh>Due Date</MudTh>
                    <MudTh>Reminder</MudTh>
                    <MudTh>Actions</MudTh>

                </HeaderContent>

                <RowTemplate>

                   <MudTd>

    <MudLink OnClick="@(() => ViewDetails(context.Id))">

    @context.InvoiceNumber

</MudLink>

</MudTd>

                    <MudTd>@context.StudentName</MudTd>

                    <MudTd>@GetSection(context)</MudTd>

                    <MudTd>@context.CourseName</MudTd>

                    <MudTd>@context.Amount</MudTd>

                    <MudTd>@context.PaidAmount</MudTd>

                    <MudTd>@context.BalanceAmount</MudTd>

                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@GetFeeStateColor(context)">
                            @GetFeeState(context)
                        </MudChip>
                    </MudTd>

                    <MudTd>
                        @context.InvoiceDate.ToShortDateString()
                    </MudTd>

                    <MudTd>
                        @context.DueDate.ToShortDateString()
                    </MudTd>

                    <MudTd>
                        @if (CanSendWhatsAppReminder(context))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Send"
                                           Color="Color.Success"
                                           Title="@GetReminderButtonTitle(context)"
                                           Href="@GetWhatsAppUrl(context)"
                                           Target="_blank" />
                                           <MudText Typo="Typo.caption"
         Color="Color.Secondary"
         Class="ml-1">
    @GetReminderStageText(context)
</MudText>
                        }
                        else if (context.Status == 3)
{
    <MudText Typo="Typo.caption" Color="Color.Success">
        ✓ Paid
    </MudText>
}
else if (HasOutstandingBalance(context))
{
    <MudText Typo="Typo.caption" Color="Color.Secondary">
        No parent phone
    </MudText>
}
else
{
    <MudText Typo="Typo.caption" Color="Color.Secondary">-</MudText>
}
                    </MudTd>

                    <MudTd>

                        <MudIconButton
                            Icon="@Icons.Material.Filled.Edit"
                            Color="Color.Primary"
                            OnClick="@(() => Edit(context.Id))" />

                        <MudIconButton
                            Icon="@Icons.Material.Filled.Delete"
                            Color="Color.Error"
                            OnClick="@(() => Delete(context.Id))" />

                    </MudTd>

                </RowTemplate>

            </MudTable>

     @if (_totalPages > 1)
{
    <div class="d-flex justify-content-center align-items-center mt-4">
        <MudPagination T="int"
                       Count="_totalPages"
                       Selected="_page"
                       SelectedChanged="OnPageChanged"
                       Size="Size.Medium"
                       Color="Color.Primary"
                       Variant="Variant.Outlined" />
    </div>

    <div class="text-center mt-2">
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Showing
            @((_page - 1) * _pageSize + 1)
            -
            @Math.Min(_page * _pageSize, _totalCount)
            of @_totalCount invoices
        </MudText>
    </div>
}
        </MudTabPanel>

        <MudTabPanel Text="Payments">

            <FeePaymentList />

        </MudTabPanel>

    </MudTabs>

</MudPaper>

@code
{
    private int _page = 1;
private int _pageSize = 20;
private int _totalCount;
private int _totalPages;

private FeeInvoiceQueryRequest _query = new()
{
    Page = 1,
    PageSize = 20
};
    private List<FeeInvoiceResponse> _invoices = new();

private List<CourseResponse> _courses = new();

private string? _studentName;
private string? _teacherName;
private Guid? _teacherId;
private Guid? _courseId;
private string? _genderFilter;
private FeeStatus? _statusFilter;

private List<TeacherResponse> _teachers = new();

   private IEnumerable<FeeInvoiceResponse> FilteredInvoices => _invoices;

private IEnumerable<FeeInvoiceResponse> DueInvoices =>
    _invoices.Where(IsDueToday);

private IEnumerable<FeeInvoiceResponse> OverdueInvoices =>
    _invoices.Where(IsOverdue);

private IEnumerable<FeeInvoiceResponse> NearingDueInvoices =>
    _invoices.Where(IsNearingDue);

  protected override async Task OnInitializedAsync()
{
    await LoadCourses();
    await LoadTeachers();

    _page = 1;
    await LoadData();
}
  private async Task LoadData()
{
    _query.Page = _page;
    _query.PageSize = _pageSize;

    _query.StudentName = string.IsNullOrWhiteSpace(_studentName)
        ? null
        : _studentName.Trim();

    _query.TeacherName = string.IsNullOrWhiteSpace(_teacherName)
        ? null
        : _teacherName.Trim();

    _query.TeacherId = _teacherId;
    _query.CourseId = _courseId;

    _query.Gender = string.IsNullOrWhiteSpace(_genderFilter)
        ? null
        : _genderFilter;

    _query.Status = _statusFilter;

    var result = await FeeInvoiceApi.GetAllAsync(_query);

    _invoices = result.Items;
    _totalCount = result.TotalCount;
    _totalPages = result.TotalPages;

    StateHasChanged();
}
    private async Task LoadCourses()
{
    try
    {
        _courses = await CourseApi.GetAllAsync();

        _courses = _courses
            .Where(x => x.IsActive)
            .OrderBy(x => x.CourseName)
            .ToList();
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex);

        Snackbar.Add(
            "Unable to load courses.",
            Severity.Error);
    }
}

    private async Task Delete(Guid id)
    {
        await FeeInvoiceApi.DeleteAsync(id);

       _page = 1;
await LoadData();

        StateHasChanged();
    }

    private async Task CreateInvoice()
    {
        var dialog =
            await DialogService.ShowAsync<FeeInvoiceDialog>(
                "Create Invoice");

        var result = await dialog.Result;

        if (result?.Canceled == true)
            return;

        var data =
            (CreateFeeInvoiceDialogModel)result.Data!;

        await FeeInvoiceApi.CreateAsync(
            new CreateFeeInvoiceRequest
            {
                EnrollmentId = data.EnrollmentId,

                InvoiceDate =
                    data.InvoiceDate ?? DateTime.Today,

                DueDate =
                    data.DueDate ??
                    DateTime.Today.AddDays(7),

                Remarks = data.Remarks
            });

       _page = 1;
await LoadData();

        StateHasChanged();
    }

    private async Task GenerateDueFees()
    {
        try
        {
            var generated = await FeeInvoiceApi.GenerateAsync(DateTime.Today);
            Snackbar.Add(
                generated > 0
                    ? $"{generated} fee invoice(s) generated."
                    : "No additional fee cycles are ready to generate.",
                generated > 0 ? Severity.Success : Severity.Info);

           _page = 1;
await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(
                $"Unable to generate due fees: {ex.Message}",
                Severity.Error);
        }
    }

   private async Task Edit(Guid id)
{
    var invoice =
        await FeeInvoiceApi.GetByIdAsync(id);

    if (invoice == null)
        return;

    var parameters =
        new DialogParameters
        {
            { nameof(EditFeeInvoiceDialog.Invoice), invoice }
        };

    var dialog =
        await DialogService.ShowAsync<
            EditFeeInvoiceDialog>(
            "Edit Invoice",
            parameters);

    var result = await dialog.Result;

    if (result?.Canceled == true)
        return;

    var request =
        (UpdateFeeInvoiceRequest)result.Data!;

    await FeeInvoiceApi.UpdateAsync(
        id,
        request);

   _page = 1;
await LoadData();

    StateHasChanged();
}
private async Task ViewDetails(Guid id)
{
    var invoice =
        await FeeInvoiceApi.GetByIdAsync(id);

    if (invoice == null)
        return;

    var parameters =
        new DialogParameters
        {
            {
                nameof(InvoiceDetailsDialog.Invoice),
                invoice
            }
        };

    await DialogService.ShowAsync<
        InvoiceDetailsDialog>(
        "Invoice Details",
        parameters);
}
    private static string GetStatusText(int status)
    {
        return status switch
        {
            1 => "Pending",
            2 => "Partially Paid",
            3 => "Paid",
            4 => "Overdue",
            _ => "Unknown"
        };
    }

   private static bool HasOutstandingBalance(FeeInvoiceResponse invoice) =>
    invoice.Status != 3 && invoice.BalanceAmount > 0;

    private static bool IsDueToday(FeeInvoiceResponse invoice) =>
        HasOutstandingBalance(invoice) && invoice.DueDate.Date == DateTime.Today;

    private static bool IsOverdue(FeeInvoiceResponse invoice) =>
        HasOutstandingBalance(invoice) && invoice.DueDate.Date < DateTime.Today;

    private static bool IsNearingDue(FeeInvoiceResponse invoice) =>
        HasOutstandingBalance(invoice) &&
        invoice.DueDate.Date > DateTime.Today &&
        invoice.DueDate.Date <= DateTime.Today.AddDays(7);

    private static string GetSection(FeeInvoiceResponse invoice) =>
        invoice.Gender == "Male" ? "Boys" :
        invoice.Gender == "Female" ? "Girls" : "Unspecified";

    private static Color GetFeeStateColor(FeeInvoiceResponse invoice) =>
        IsOverdue(invoice) ? Color.Error :
        IsDueToday(invoice) ? Color.Warning :
        IsNearingDue(invoice) ? Color.Info : Color.Default;

    private static string GetFeeState(FeeInvoiceResponse invoice) =>
        IsOverdue(invoice) ? "Overdue" :
        IsDueToday(invoice) ? "Due today" :
        IsNearingDue(invoice) ? "Due soon" : GetStatusText(invoice.Status);

    private enum FeeReminderStage
{
    None,
    SevenDaysBefore,
    ThreeDaysBefore,
    DueToday,
    Overdue
}

private static FeeReminderStage GetReminderStage(FeeInvoiceResponse invoice)
{
    if (!HasOutstandingBalance(invoice))
        return FeeReminderStage.None;

    var daysUntilDue =
        (invoice.DueDate.Date - DateTime.Today).Days;

    return daysUntilDue switch
    {
        < 0 => FeeReminderStage.Overdue,
        0 => FeeReminderStage.DueToday,
        <= 3 => FeeReminderStage.ThreeDaysBefore,
        <= 7 => FeeReminderStage.SevenDaysBefore,
        _ => FeeReminderStage.None
    };
}

private static bool CanSendWhatsAppReminder(FeeInvoiceResponse invoice) =>
    GetReminderStage(invoice) != FeeReminderStage.None &&
    !string.IsNullOrWhiteSpace(invoice.ParentPhoneNumber);

private static string GetReminderButtonTitle(FeeInvoiceResponse invoice)
{
    return GetReminderStage(invoice) switch
    {
        FeeReminderStage.SevenDaysBefore =>
            "Send 7-day fee reminder",

        FeeReminderStage.ThreeDaysBefore =>
            "Send 3-day fee reminder",

        FeeReminderStage.DueToday =>
            "Send due-today fee reminder",

        FeeReminderStage.Overdue =>
            "Send overdue fee reminder",

        _ =>
            "Send WhatsApp fee reminder"
    };
}

private static string GetReminderStageText(FeeInvoiceResponse invoice)
{
    return GetReminderStage(invoice) switch
    {
        FeeReminderStage.SevenDaysBefore =>
            "7-day reminder",

        FeeReminderStage.ThreeDaysBefore =>
            "3-day reminder",

        FeeReminderStage.DueToday =>
            "Due today",

        FeeReminderStage.Overdue =>
            "Overdue",

        _ => string.Empty
    };
}

private static string GetWhatsAppUrl(FeeInvoiceResponse invoice)
{
    var phone = new string(
        (invoice.ParentPhoneNumber ?? string.Empty)
            .Where(char.IsDigit)
            .ToArray());

    var stage = GetReminderStage(invoice);

    var message = stage switch
    {
        FeeReminderStage.SevenDaysBefore =>
            $"Assalamu Alaikum {invoice.ParentName ?? "Parent"},\n\n" +
            $"This is a friendly reminder that the fee payment for " +
            $"{invoice.StudentName} ({invoice.CourseName}) " +
            $"is due in 7 days.\n\n" +
            $"Invoice: {invoice.InvoiceNumber}\n" +
            $"Amount Due: ₹{invoice.BalanceAmount:N2}\n" +
            $"Due Date: {invoice.DueDate:dd MMM yyyy}\n\n" +
            $"Kindly arrange the payment before the due date.\n\n" +
            $"JazakAllahu Khairan.",

        FeeReminderStage.ThreeDaysBefore =>
            $"Assalamu Alaikum {invoice.ParentName ?? "Parent"},\n\n" +
            $"This is a gentle reminder that the fee payment for " +
            $"{invoice.StudentName} ({invoice.CourseName}) " +
            $"is due in 3 days.\n\n" +
            $"Invoice: {invoice.InvoiceNumber}\n" +
            $"Amount Due: ₹{invoice.BalanceAmount:N2}\n" +
            $"Due Date: {invoice.DueDate:dd MMM yyyy}\n\n" +
            $"Kindly arrange the payment before the due date.\n\n" +
            $"JazakAllahu Khairan.",

        FeeReminderStage.DueToday =>
            $"Assalamu Alaikum {invoice.ParentName ?? "Parent"},\n\n" +
            $"This is a reminder that the fee payment for " +
            $"{invoice.StudentName} ({invoice.CourseName}) " +
            $"is due today.\n\n" +
            $"Invoice: {invoice.InvoiceNumber}\n" +
            $"Amount Due: ₹{invoice.BalanceAmount:N2}\n" +
            $"Due Date: {invoice.DueDate:dd MMM yyyy}\n\n" +
            $"Kindly arrange the payment today.\n\n" +
            $"JazakAllahu Khairan.",

        FeeReminderStage.Overdue =>
            $"Assalamu Alaikum {invoice.ParentName ?? "Parent"},\n\n" +
            $"This is a reminder that the fee payment for " +
            $"{invoice.StudentName} ({invoice.CourseName}) " +
            $"is overdue.\n\n" +
            $"Invoice: {invoice.InvoiceNumber}\n" +
            $"Outstanding Amount: ₹{invoice.BalanceAmount:N2}\n" +
            $"Due Date: {invoice.DueDate:dd MMM yyyy}\n\n" +
            $"Kindly arrange the payment at your earliest convenience.\n\n" +
            $"JazakAllahu Khairan.",

        _ => string.Empty
    };

    return $"https://wa.me/{phone}?text={Uri.EscapeDataString(message)}";
}

private async Task OnPageChanged(int page)
{
    _page = page;
await LoadData();
}

private async Task LoadTeachers()
{
    try
    {
        var result = await TeacherApi.GetTeachersAsync(
            new TeacherQueryRequest
            {
                Page = 1,
                PageSize = 1000
            });

        _teachers = result?.Data?.Items?
            .Where(x => x.IsActive)
            .OrderBy(x => x.FullName)
            .ToList()
            ?? new List<TeacherResponse>();
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex);

        Snackbar.Add(
            "Unable to load teachers.",
            Severity.Error);
    }
}

private async Task ApplyFilters()
{
    _page = 1;
    await LoadData();
}

private async Task ClearFilters()
{
    _studentName = null;
    _teacherName = null;
    _teacherId = null;
    _courseId = null;
    _genderFilter = null;
    _statusFilter = null;

    _page = 1;

    await LoadData();
}

private async Task DownloadExcelAsync()
{
    try
    {
        var request = new FeeInvoiceQueryRequest
        {
            StudentName = _studentName,
            TeacherName = _teacherName,
            TeacherId = _teacherId,
            CourseId = _courseId,
            Gender = _genderFilter,
            Status = _statusFilter
        };

        Snackbar.Add(
            "Preparing Excel file...",
            Severity.Info);

        var invoices =
            await FeeInvoiceApi.GetAllForExportAsync(request);

        using var workbook = new XLWorkbook();

        var worksheet =
            workbook.Worksheets.Add("Fee Invoices");

        var headers = new[]
        {
            "Invoice No",
            "Admission No",
            "Student",
            "Mobile",
            "Gender",
            "Teacher",
            "Course",
            "Amount",
            "Paid",
            "Balance",
            "Status",
            "Invoice Date",
            "Due Date",
            "Paid Date",
            "Remarks"
        };

        for (var i = 0; i < headers.Length; i++)
        {
            worksheet.Cell(1, i + 1).Value = headers[i];
        }

        var headerRange =
            worksheet.Range(
                1,
                1,
                1,
                headers.Length);

        headerRange.Style.Font.Bold = true;

        var row = 2;

        foreach (var invoice in invoices)
        {
            worksheet.Cell(row, 1).Value =
                invoice.InvoiceNumber;

            worksheet.Cell(row, 2).Value =
                invoice.AdmissionNumber ?? "";

            worksheet.Cell(row, 3).Value =
                invoice.StudentName;

            worksheet.Cell(row, 4).Value =
                invoice.ParentPhoneNumber ?? "";

            worksheet.Cell(row, 5).Value =
                invoice.Gender;

            worksheet.Cell(row, 6).Value =
                invoice.TeacherName ?? "";

            worksheet.Cell(row, 7).Value =
                invoice.CourseName;

            worksheet.Cell(row, 8).Value =
                invoice.Amount;

            worksheet.Cell(row, 9).Value =
                invoice.PaidAmount;

            worksheet.Cell(row, 10).Value =
                invoice.BalanceAmount;

            worksheet.Cell(row, 11).Value =
                GetFeeState(invoice);

            worksheet.Cell(row, 12).Value =
                invoice.InvoiceDate;

            worksheet.Cell(row, 13).Value =
                invoice.DueDate;

            worksheet.Cell(row, 14).Value =
                invoice.PaidDate;

            worksheet.Cell(row, 15).Value =
                invoice.Remarks ?? "";

            row++;
        }

        worksheet.Column(8).Style.NumberFormat.Format = "₹#,##0.00";
        worksheet.Column(9).Style.NumberFormat.Format = "₹#,##0.00";
        worksheet.Column(10).Style.NumberFormat.Format = "₹#,##0.00";

        worksheet.Column(12).Style.NumberFormat.Format =
            "dd/MM/yyyy";

        worksheet.Column(13).Style.NumberFormat.Format =
            "dd/MM/yyyy";

        worksheet.Column(14).Style.NumberFormat.Format =
            "dd/MM/yyyy";

        worksheet.Columns().AdjustToContents();

        using var stream = new MemoryStream();

        workbook.SaveAs(stream);

        var bytes = stream.ToArray();

        var base64 =
            Convert.ToBase64String(bytes);

        var fileName =
            $"FeeInvoices_{DateTime.Now:yyyyMMdd_HHmmss}.xlsx";

        await JS.InvokeVoidAsync(
            "downloadFile",
            fileName,
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
            base64);

        Snackbar.Add(
            $"{invoices.Count} invoice(s) exported to Excel.",
            Severity.Success);
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex);

        Snackbar.Add(
            $"Unable to download Excel: {ex.Message}",
            Severity.Error);
    }
}

private async Task DownloadPdfAsync()
{
    try
    {
        var request = new FeeInvoiceQueryRequest
        {
            StudentName = _studentName,
            TeacherName = _teacherName,
            TeacherId = _teacherId,
            CourseId = _courseId,
            Gender = _genderFilter,
            Status = _statusFilter
        };

        Snackbar.Add(
            "Preparing PDF file...",
            Severity.Info);

        var bytes =
            await FeeInvoiceApi.DownloadFilteredPdfAsync(request);

        var base64 =
            Convert.ToBase64String(bytes);

        var fileName =
            $"FeeInvoices_{DateTime.Now:yyyyMMdd_HHmmss}.pdf";

        await JS.InvokeVoidAsync(
            "downloadFile",
            fileName,
            "application/pdf",
            base64);

        Snackbar.Add(
            "PDF file downloaded successfully.",
            Severity.Success);
    }
    catch (Exception ex)
    {
        Console.WriteLine(ex);

        Snackbar.Add(
            $"Unable to download PDF: {ex.Message}",
            Severity.Error);
    }
}
}
