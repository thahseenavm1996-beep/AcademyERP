@page "/students"

@using Microsoft.AspNetCore.Authorization


@using AcademyERP.Admin.Models
@using AcademyERP.Admin.Services
@inject StudentApiService StudentApi
@using AcademyERP.Admin.Components.Pages.Students
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>Students</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Student Management
</MudText>

<MudPaper Class="pa-4 mb-4">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">

        <MudTextField T="string" Value="@_search" ValueChanged="OnSearchChanged"
                      Placeholder="Search by name or admission no..." Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true" Clearable="true" Style="width:350px" />

        
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenAddStudentDialog">

            Add Student

        </MudButton>

    </MudStack>

</MudPaper>

<MudTable T="StudentResponse" Items="_students" Loading="_loading" Hover="true" Dense="true" Striped="true">

    
    <!-- <HeaderContent>

        <MudTh>Admission No</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Admission Date</MudTh>
        <MudTh>Country</MudTh>

    </HeaderContent>-->
    <HeaderContent>

        <MudTh>Admission No</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Admission Date</MudTh>
        <MudTh>Country</MudTh>
        <MudTh>Actions</MudTh>

    </HeaderContent>

    <RowTemplate>

        <MudTd>@context.AdmissionNumber</MudTd>

        <MudTd>@context.FullName</MudTd>

        <MudTd>
            @context.AdmissionDate.ToString("dd MMM yyyy")
        </MudTd>

        <MudTd>
            @context.Country
        </MudTd>
        <MudTd>
            <MudTooltip Text="View Student">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small"
                               OnClick="@(() => ViewStudent(context.Id))" />
            </MudTooltip>
            <MudTooltip Text="Edit Student">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => EditStudent(context))" />
            </MudTooltip>

            <MudTooltip Text="Reset Password">
                <MudIconButton Icon="@Icons.Material.Filled.LockReset" Color="Color.Warning" Size="Size.Small"
                               OnClick="@(() => OpenResetPasswordDialog(context.Id))" />
            </MudTooltip>
<MudIconButton
    Icon="@Icons.Material.Filled.Assessment"
    Color="Color.Success"
    OnClick="@(() => OpenReport(context.Id))"
/>
            <MudTooltip Text="Delete Student">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DeleteStudent(context))" />
            </MudTooltip>

        </MudTd>

    </RowTemplate>

</MudTable>
@if (!_loading && !_students.Any())
{
    <MudAlert Severity="Severity.Info">

        No students found.

    </MudAlert>
}

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-4">

    <MudButton Variant="Variant.Outlined" Disabled="@(_page.Page <= 1)" OnClick="PreviousPage">

        Previous

    </MudButton>

    <MudText>

        Page @_page.Page of @_page.TotalPages

    </MudText>

    <MudButton Variant="Variant.Outlined" Disabled="@(_page.Page >= _page.TotalPages)" OnClick="NextPage">

        Next

    </MudButton>

</MudStack>
<MudText Class="mt-4">

    Showing @_students.Count of @_page.TotalCount students
    (Page @_page.Page of @_page.TotalPages)

</MudText>
@code
{
    private List<StudentResponse> _students = new();
    private StudentData _page = new();

    private bool _loading = true;
    private string _search = string.Empty;

    private readonly StudentQueryRequest _request = new()
    {
        Page = 1,
        PageSize = 10
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadStudentsAsync();
    }
    private async Task LoadStudentsAsync()
    {
        try
        {
            Console.WriteLine("LoadStudentsAsync started");

            _loading = true;

            var response = await StudentApi.GetStudentsAsync(_request);

            Console.WriteLine("API call finished");

            if (response != null)
            {
                Console.WriteLine("Response received");

                _page = response.Data;
                _students = _page.Items;
            }

            _loading = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.ToString());

            Snackbar.Add(ex.ToString(), Severity.Error);
        }
    }
    /* private async Task LoadStudentsAsync()
      {
          _loading = true;

          var response = await StudentApi.GetStudentsAsync(_request);

          if (response is not null)
          {
              _page = response.Data;
              _students = _page.Items;
          }

          _loading = false;
      }*/
    private async Task NextPage()
    {
        if (_page.Page >= _page.TotalPages)
            return;

        _request.Page++;

        await LoadStudentsAsync();
    }

    private async Task PreviousPage()
    {
        if (_page.Page <= 1)
            return;

        _request.Page--;

        await LoadStudentsAsync();
    }

    private async Task SearchStudents()
    {
        Console.WriteLine("Search button clicked");

        _request.Page = 1;
        _request.Search = _search;

        await LoadStudentsAsync();
    }
    private async Task OnSearchChanged(string value)
    {
        Console.WriteLine($"Searching for: {value}");
        _search = value;

        _request.Page = 1;
        _request.Search = _search;

        await LoadStudentsAsync();
    }
    private async Task OpenAddStudentDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<StudentDialog>(
            "Add Student",
            options);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadStudentsAsync();
        }
    }
    private void ViewStudent(Guid id)
    {
        Navigation.NavigateTo($"/students/{id}");
    }
    private async Task EditStudent(StudentResponse student)
    {
        var parameters = new DialogParameters<StudentDialog>
    {
        { x => x.Student, student },
        { x => x.IsEdit, true }
    };

        var dialog = await DialogService.ShowAsync<StudentDialog>(
            "Update Student",
            parameters);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadStudentsAsync();
        }
    }
    private async Task DeleteStudent(StudentResponse student)
    {
        var success = await StudentApi.DeleteStudentAsync(student.Id);

        if (success)
        {
            Snackbar.Add("Student deleted successfully.", Severity.Success);
            await LoadStudentsAsync();
        }
        else
        {
            Snackbar.Add("Failed to delete student.", Severity.Error);
        }
    }
    private async Task OpenResetPasswordDialog(Guid studentId)
    {
        Snackbar.Add("Reset button clicked!", Severity.Success);

        var parameters = new DialogParameters
        {
            ["StudentId"] = studentId
        };

        var dialog = await DialogService.ShowAsync<ResetStudentPasswordDialog>(
            "Reset Password",
            parameters);

        await dialog.Result;
    }
    private void OpenReport(Guid studentId)
{
    Navigation.NavigateTo(
        $"/students/report/{studentId}");
}
}