@using AcademyERP.Admin.Models.TeacherDashboard
@using AcademyERP.Domain.Enums
@using MudBlazor
@using AcademyERP.Admin.Models.Attendance
@using AcademyERP.Admin.Models.ClassProgress
@using AcademyERP.Admin.Models.ClassReports

<MudDialog>

<DialogContent>


<MudText Class="mt-3">
    Student:
    <b>@Class.StudentName</b>
</MudText>


<MudText>
    Course:
    <b>@Class.CourseName</b>
</MudText>


<MudRadioGroup T="AttendanceStatus"
               @bind-Value="_status">

    <MudRadio T="AttendanceStatus"
              Value="AttendanceStatus.Present">
        Present
    </MudRadio>

    <MudRadio T="AttendanceStatus"
              Value="AttendanceStatus.Absent">
        Absent
    </MudRadio>

    <MudRadio T="AttendanceStatus"
              Value="AttendanceStatus.Late">
        Late
    </MudRadio>

    <MudRadio T="AttendanceStatus"
              Value="AttendanceStatus.Leave">
        Leave
    </MudRadio>

</MudRadioGroup>
<MudDivider Class="my-4" />

<MudText Typo="Typo.h6">
    Lesson Progress
</MudText>


<MudTextField T="string"
              Label="Lesson Title"
              Variant="Variant.Outlined"
              Class="mt-3"
              @bind-Value="_lessonTitle" />


<MudTextField T="string"
              Label="Chapter Name"
              Variant="Variant.Outlined"
              Class="mt-3"
              @bind-Value="_chapterName" />


<MudTextField T="string"
              Label="Pages Covered"
              Variant="Variant.Outlined"
              Class="mt-3"
              @bind-Value="_pagesCovered" />
<MudCheckBox T="bool"
             Label="Lesson Completed"
             @bind-Value="_isLessonCompleted" />

<MudDivider Class="my-4" />


<MudText Typo="Typo.h6">
    Homework
</MudText>


<MudCheckBox T="bool"
             Label="Homework Given"
             @bind-Value="_homeworkGiven" />


@if(_homeworkGiven)
{
    <MudTextField T="string"
                  Label="Homework Details"
                  Variant="Variant.Outlined"
                  Class="mt-3"
                  @bind-Value="_homework" />


    <MudCheckBox T="bool"
                 Label="Homework Completed"
                 @bind-Value="_homeworkCompleted" />
}


<MudTextField T="string"
              Label="Teacher Notes"
              Variant="Variant.Outlined"
              Lines="3"
              Class="mt-3"
              @bind-Value="_teacherNotes" />

<MudTextField
    Label="Remarks"
    Lines="3"
    @bind-Value="_remarks" />

<MudDivider Class="my-4" />

<MudText Typo="Typo.h6">
    Class Report
</MudText>

<MudSelect T="PerformanceRating"
           Label="Performance"
           Variant="Variant.Outlined"
           Class="mt-3"
           @bind-Value="_performanceRating">

    @foreach (PerformanceRating item in Enum.GetValues<PerformanceRating>())
    {
        <MudSelectItem T="PerformanceRating" Value="@item">
            @item
        </MudSelectItem>
    }

</MudSelect>

<MudSelect T="HomeworkStatus"
           Label="Homework Status"
           Variant="Variant.Outlined"
           Class="mt-3"
           @bind-Value="_homeworkStatus">

    @foreach (HomeworkStatus item in Enum.GetValues<HomeworkStatus>())
    {
        <MudSelectItem T="HomeworkStatus" Value="@item">
            @item
        </MudSelectItem>
    }

</MudSelect>

<MudSelect T="BehaviourRating"
           Label="Behaviour"
           Variant="Variant.Outlined"
           Class="mt-3"
           @bind-Value="_behaviourRating">

    @foreach (BehaviourRating item in Enum.GetValues<BehaviourRating>())
    {
        <MudSelectItem T="BehaviourRating" Value="@item">
            @item
        </MudSelectItem>
    }

</MudSelect>

<MudSelect T="ClassOutcome"
           Label="Class Outcome"
           Variant="Variant.Outlined"
           Class="mt-3"
           @bind-Value="_classOutcome">

    @foreach (ClassOutcome item in Enum.GetValues<ClassOutcome>())
    {
        <MudSelectItem T="ClassOutcome" Value="@item">
            @item
        </MudSelectItem>
    }

</MudSelect>

<MudTextField T="string"
              Label="Lesson Taken"
              Variant="Variant.Outlined"
              Lines="3"
              Class="mt-3"
              Required="true"
              @bind-Value="_lessonTaken" />

<MudTextField T="string"
              Label="Next Homework"
              Variant="Variant.Outlined"
              Lines="3"
              Class="mt-3"
              @bind-Value="_nextHomework" />

<MudTextField T="string"
              Label="Teacher Remarks"
              Variant="Variant.Outlined"
              Lines="3"
              Class="mt-3"
              @bind-Value="_reportTeacherRemarks" />

<MudNumericField T="int"
                 Label="Actual Duration (Minutes)"
                 Variant="Variant.Outlined"
                 Min="1"
                 Max="300"
                 Class="mt-3"
                 @bind-Value="_actualDurationMinutes" />
</DialogContent>


<DialogActions>

<MudButton OnClick="Cancel">
Cancel
</MudButton>


<MudButton Color="Color.Success"
           Variant="Variant.Filled"
           OnClick="Save">
Complete
</MudButton>


</DialogActions>


</MudDialog>


@code {

[CascadingParameter]
IMudDialogInstance MudDialog {get;set;} = default!;


[Parameter]
public TodayClassResponse Class {get;set;} = new();


private AttendanceStatus _status =
    AttendanceStatus.Present;

private string? _lessonTitle;

private string? _chapterName;

private string? _pagesCovered;


private bool _homeworkGiven;

private string? _homework;

private bool _homeworkCompleted;

private bool _isLessonCompleted;
private string? _teacherNotes;
private string? _remarks;
private PerformanceRating _performanceRating =
    PerformanceRating.Good;

private HomeworkStatus _homeworkStatus;

private BehaviourRating _behaviourRating;

private ClassOutcome _classOutcome;

private string _lessonTaken = string.Empty;

private string _nextHomework = string.Empty;

private string? _reportTeacherRemarks;

private int _actualDurationMinutes = 30;

private void Cancel()
{
    MudDialog.Cancel();
}


private void Save()
{MudDialog.Close(
    DialogResult.Ok(
        new CompleteClassRequest
        {
            Attendance = new CreateAttendanceRequest
            {
                ScheduledClassId =
                    Class.ScheduledClassId,

                Status = _status,

                Remarks = _remarks
            },


            Progress = new CreateClassProgressRequest
{
    ScheduledClassId =
        Class.ScheduledClassId,

    LessonTitle = _lessonTitle,

    ChapterName = _chapterName,

    PagesCovered = _pagesCovered,

    IsLessonCompleted =
        _isLessonCompleted,

    HomeworkGiven =
        _homeworkGiven,

    Homework =
        _homework,

    HomeworkCompleted =
        _homeworkCompleted,

    TeacherNotes =
        _teacherNotes
},

Report = new CreateClassReportRequest
{
    ScheduledClassId =
        Class.ScheduledClassId,

    PerformanceRating =
        _performanceRating,

    HomeworkStatus =
        _homeworkStatus,

    BehaviourRating =
        _behaviourRating,

    ClassOutcome =
        _classOutcome,

    LessonTaken =
        _lessonTaken,

    NextHomework =
        _nextHomework,

    TeacherRemarks =
        _reportTeacherRemarks,

    ActualDurationMinutes =
        _actualDurationMinutes
}
        }));
}

}