@using AcademyERP.Admin.Models

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h5" Class="mb-4">@Teacher.FullName</MudText>
        <MudGrid>
            <MudItem xs="12" sm="6"><MudText><b>Employee code:</b> @Teacher.EmployeeCode</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudText><b>Status:</b> @(Teacher.IsActive ? "Active" : "Inactive")</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudText><b>Mobile:</b> @Teacher.MobileNumber</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudText><b>Email:</b> @Teacher.Email</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudText><b>Department:</b> @Teacher.Department</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudText><b>Qualification:</b> @Teacher.Qualification</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudText><b>Joining date:</b> @Teacher.JoiningDate.ToString("dd MMM yyyy")</MudText></MudItem>
            <MudItem xs="12" sm="6"><MudText><b>Country:</b> @Teacher.Country</MudText></MudItem>
            <MudItem xs="12"><MudText><b>Address:</b> @(Teacher.Address ?? "-")</MudText></MudItem>
            <MudItem xs="12"><MudText><b>Remarks:</b> @(Teacher.Remarks ?? "-")</MudText></MudItem>
            <MudItem xs="12">
    <MudDivider Class="my-3" />

    <MudText Typo="Typo.h6" Class="mb-3">
        Available Slots
    </MudText>

    @if (Teacher.Availability is null || Teacher.Availability.Count == 0)
    {
        <MudAlert Severity="Severity.Info">
            No availability has been configured for this teacher.
        </MudAlert>
    }
    else
    {
        @foreach (var day in Enum.GetValues<DayOfWeek>())
        {
            var daySlots = Teacher.Availability
                .Where(x => x.DayOfWeek == day)
                .OrderBy(x => x.StartTime)
                .ToList();

            @if (daySlots.Count > 0)
            {
                <MudPaper Class="pa-3 mb-2" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">
                        @day
                    </MudText>

                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                        @foreach (var slot in daySlots)
                        {
                            <MudChip T="string"
                                     Color="Color.Primary"
                                     Variant="Variant.Outlined">
                                @slot.TimeSlotName
                            </MudChip>
                        }
                    </MudStack>
                </MudPaper>
            }
        }
    }
</MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions><MudButton OnClick="Close">Close</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public TeacherResponse Teacher { get; set; } = default!;
    private void Close() => MudDialog.Close();
}
