@using MudBlazor
@using AcademyERP.Admin.Models
@using AcademyERP.Admin.Services
@using AcademyERP.Admin.Models.Lookups
@using AcademyERP.Domain.Enums

@inject TeacherApiService TeacherApi
@inject ISnackbar Snackbar

<MudDialog>

    <DialogContent>

        <!-- <MudText Typo="Typo.h5">
            @(IsEdit ? "Edit Teacher" : "Add Teacher")
        </MudText>-->
        <MudForm @ref="_form">

            <!--  <MudTextField T="string" Label="Admission Number" @bind-Value="_model.AdmissionNumber"
                          For="@(() => _model.AdmissionNumber)" />-->

            <MudTextField Label="Full Name" @bind-Value="_model.FullName" Required="true" />

            <MudDatePicker Label="Joining Date" @bind-Date="_model.JoiningDate" Required="true" />

            <MudDatePicker Label="Date of Birth" @bind-Date="_model.DateOfBirth" Required="true" />

            <MudSelect T="int" Label="Gender" @bind-Value="_model.Gender">
                <MudSelectItem Value="1">Male</MudSelectItem>
                <MudSelectItem Value="2">Female</MudSelectItem>
                <MudSelectItem Value="3">Other</MudSelectItem>
            </MudSelect>

            <MudTextField Label="Mobile Number" @bind-Value="_model.MobileNumber" />

            <MudTextField Label="Email" @bind-Value="_model.Email" />

            <MudTextField Label="Qualification" @bind-Value="_model.Qualification" />

            <MudTextField Label="Department" @bind-Value="_model.Department" />

            <MudTextField Label="Country" @bind-Value="_model.Country" />

            <MudTextField Label="Time Zone" @bind-Value="_model.TimeZone" />
            <MudDivider Class="my-4" />

<MudText Typo="Typo.h6" Class="mb-2">
    Teacher Availability
</MudText>

<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
    Select the days and time slots when this teacher is available.
</MudText>

@if (_timeSlots.Count == 0)
{
    <MudAlert Severity="Severity.Warning">
        No active time slots are available.
    </MudAlert>
}
else
{
    @foreach (var day in _days)
    {
        <MudPaper Class="pa-3 mb-3" Outlined="true">
            <MudText Typo="Typo.subtitle1" Class="mb-2">
                @day
            </MudText>

            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1">
                @foreach (var slot in _timeSlots)
                {
                    var selected = IsSlotSelected(day, slot.Id);

                    <MudChip T="string"
                             Color="@(selected ? Color.Primary : Color.Default)"
                             Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                             OnClick="@(() => ToggleSlot(day, slot.Id))">
                        @slot.Name
                        @if (slot.StartTime != default || slot.EndTime != default)
                        {
                            <span class="ml-1">
                                (@slot.StartTime.ToString("HH:mm") -
                                @slot.EndTime.ToString("HH:mm"))
                            </span>
                        }
                    </MudChip>
                }
            </MudStack>
        </MudPaper>
    }
}
            @if (!IsEdit)
            {
                <MudTextField T="string" Label="Password" @bind-Value="_model.Password" InputType="InputType.Password"
                              Required="true" RequiredError="Password is required."
                              Validation="@(new Func<string, IEnumerable<string>>(ValidatePassword))" Immediate="true"
                              HelperText="Minimum 6 characters" />
            }

            <MudTextField Label="Address" @bind-Value="_model.Address" />

            <MudTextField Label="Remarks" @bind-Value="_model.Remarks" Lines="3" TextArea="true" />
        </MudForm>
    </DialogContent>

    <DialogActions>

        <MudButton OnClick="Cancel">
            Cancel
        </MudButton>

        <!-- <MudButton Color="Color.Primary">
            Save
        </MudButton>-->
        <MudButton Color="Color.Primary" OnClick="Save">
            @(IsEdit ? "Update" : "Save")
        </MudButton>

    </DialogActions>

</MudDialog>

@code {
    [Parameter]
    public TeacherResponse? Teacher { get; set; }

    [Parameter]
    public bool IsEdit { get; set; }

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private void Cancel()
    {
        MudDialog.Cancel();
    }
    private CreateTeacherRequest _model = new();
    private async Task Save()
    {
        if (IsEdit)
        {
            var updateRequest = new UpdateTeacherRequest
            {
                FullName = _model.FullName,
                JoiningDate = _model.JoiningDate!.Value,
                DateOfBirth = _model.DateOfBirth!.Value,
                Gender = _model.Gender,

                MobileNumber = _model.MobileNumber,
                Email = _model.Email,
                Qualification = _model.Qualification,
                Department = _model.Department,

                Country = _model.Country,
                TimeZone = _model.TimeZone,
                Address = _model.Address,
                Remarks = _model.Remarks,
                Availability = BuildAvailability()
            };
           _model.Availability = BuildAvailability();
            var result = await TeacherApi.UpdateTeacherAsync(TeacherId, updateRequest);
            if (result.Success)
            {
                Snackbar.Add("Teacher updated successfully!", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                foreach (var error in result.Errors)
                    Snackbar.Add(error, Severity.Error);
            }
        }
        else
        {
            await _form!.ValidateAsync();

            if (!_form.IsValid)
                return;
            Console.WriteLine(System.Text.Json.JsonSerializer.Serialize(_model));
            var result = await TeacherApi.CreateTeacherAsync(_model);

            if (result.Success)
            {
                Snackbar.Add("Teacher created successfully!", Severity.Success);

                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                foreach (var error in result.Errors)
                {
                    Snackbar.Add(error, Severity.Error);
                }
            }
        }
    }
    private MudForm? _form;
    protected override async Task OnInitializedAsync()
{
    await LoadTimeSlotsAsync();

    if (IsEdit && Teacher is not null)
    {
        TeacherId = Teacher.Id;

        _model.FullName = Teacher.FullName;
        _model.JoiningDate = Teacher.JoiningDate;
        _model.DateOfBirth = Teacher.DateOfBirth;
        _model.Gender = Teacher.Gender;
        _model.Country = Teacher.Country;
        _model.TimeZone = Teacher.TimeZone;
        _model.Remarks = Teacher.Remarks;

        _model.MobileNumber = Teacher.MobileNumber;
        _model.Email = Teacher.Email;
        _model.Qualification = Teacher.Qualification;
        _model.Department = Teacher.Department;
        _model.Address = Teacher.Address;

        foreach (var availability in Teacher.Availability)
        {
            _selectedAvailability.Add(
                (availability.DayOfWeek, availability.TimeSlotId));
        }
    }
}
    private Guid TeacherId;
    private IEnumerable<string> ValidatePassword(string password)
    {
        if (string.IsNullOrWhiteSpace(password))
            yield return "Password is required.";

        if (password.Length < 6)
            yield return "Password must be at least 6 characters.";

        if (!password.Any(char.IsUpper))
            yield return "Password must contain at least one uppercase letter.";

        if (!password.Any(char.IsDigit))
            yield return "Password must contain at least one number.";

        if (!password.Any(ch => !char.IsLetterOrDigit(ch)))
            yield return "Password must contain at least one special character.";
    }

    private List<TimeSlotResponse> _timeSlots = new();

private readonly DayOfWeek[] _days =
{
    DayOfWeek.Monday,
    DayOfWeek.Tuesday,
    DayOfWeek.Wednesday,
    DayOfWeek.Thursday,
    DayOfWeek.Friday,
    DayOfWeek.Saturday,
    DayOfWeek.Sunday
};

private readonly HashSet<(DayOfWeek Day, Guid TimeSlotId)> _selectedAvailability = new();

private async Task LoadTimeSlotsAsync()
{
    try
    {
        _timeSlots = await TeacherApi.GetTimeSlotsAsync();
    }
    catch (Exception ex)
    {
        Console.WriteLine($"Failed to load time slots: {ex.Message}");

        Snackbar.Add(
            "Unable to load teacher time slots.",
            Severity.Error);
    }
}

private bool IsSlotSelected(
    DayOfWeek day,
    Guid timeSlotId)
{
    return _selectedAvailability.Contains(
        (day, timeSlotId));
}

private void ToggleSlot(
    DayOfWeek day,
    Guid timeSlotId)
{
    var key = (day, timeSlotId);

    if (!_selectedAvailability.Add(key))
    {
        _selectedAvailability.Remove(key);
    }
}

private List<TeacherAvailabilityRequest> BuildAvailability()
{
    return _selectedAvailability
        .Select(x => new TeacherAvailabilityRequest
        {
            DayOfWeek = x.Day,
            TimeSlotId = x.TimeSlotId
        })
        .ToList();
}
}