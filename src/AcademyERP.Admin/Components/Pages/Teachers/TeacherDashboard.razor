@page "/Teachers/TeacherDashboard"

@layout TeacherLayout

@using AcademyERP.Application.DTOs.ScheduledClasses
@using AcademyERP.Domain.Enums
@using AcademyERP.Admin.Services
@using AcademyERP.Admin.Models.TeacherDashboard
@using AcademyERP.Admin.Components.Pages.Attendance
@using AcademyERP.Admin.Models.Attendance
@using AcademyERP.Admin.Models.ClassProgress

@inject ClassReportApiService ClassReportApi
@inject ISnackbar Snackbar
@inject TeacherDashboardApiService DashboardApi
@inject IDialogService DialogService
@inject AttendanceApiService AttendanceApi
@inject ClassProgressApiService ClassProgressApi
@inject NavigationManager NavigationManager


<PageTitle>
    Teacher Dashboard
</PageTitle>


<MudContainer MaxWidth="MaxWidth.False">


    <!-- Welcome Banner -->

    <MudPaper Class="pa-6 mb-6"
              Elevation="3"
              Style="border-radius:20px;">

        <MudText Typo="Typo.h4">
            Assalamu Alaikum 👋
        </MudText>


        <MudText Typo="Typo.subtitle1"
                 Class="mt-2">

            Welcome back, Teacher.
            Have a productive teaching day 🌸

        </MudText>

    </MudPaper>



    <!-- Summary Cards -->

    <MudGrid>


        <MudItem xs="12"
                 sm="6"
                 md="3">

            <MudCard Elevation="3">

                <MudCardContent>

                    <MudIcon Icon="@Icons.Material.Filled.Class"
                             Size="Size.Large"/>


                    <MudText Typo="Typo.subtitle2"
                             Class="mt-3">

                        Today's Classes

                    </MudText>


                    <MudText Typo="Typo.h3">

                        @(DashboardData?.Summary.TotalClassesToday ?? 0)

                    </MudText>


                </MudCardContent>

            </MudCard>

        </MudItem>




        <MudItem xs="12"
                 sm="6"
                 md="3">

            <MudCard Elevation="3">

                <MudCardContent>


                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                             Size="Size.Large"/>


                    <MudText Typo="Typo.subtitle2"
                             Class="mt-3">

                        Completed

                    </MudText>


                    <MudText Typo="Typo.h3">

                        @(DashboardData?.Summary.CompletedClasses ?? 0)

                    </MudText>


                </MudCardContent>

            </MudCard>

        </MudItem>




        <MudItem xs="12"
                 sm="6"
                 md="3">


            <MudCard Elevation="3">

                <MudCardContent>


                    <MudIcon Icon="@Icons.Material.Filled.PendingActions"
                             Size="Size.Large"/>


                    <MudText Typo="Typo.subtitle2"
                             Class="mt-3">

                        Pending

                    </MudText>


                    <MudText Typo="Typo.h3">

                        @(DashboardData?.Summary.PendingClasses ?? 0)

                    </MudText>


                </MudCardContent>


            </MudCard>


        </MudItem>





        <MudItem xs="12"
                 sm="6"
                 md="3">


            <MudCard Elevation="3">

                <MudCardContent>


                    <MudIcon Icon="@Icons.Material.Filled.TrendingUp"
                             Size="Size.Large"/>


                    <MudText Typo="Typo.subtitle2"
                             Class="mt-3">

                        Completion

                    </MudText>


                    <MudProgressLinear Value="@(DashboardData?.Summary.CompletionPercentage ?? 0)"
                                       Rounded="true"
                                       Class="mt-3"/>


                    <MudText>
                        @(DashboardData?.Summary.CompletionPercentage ?? 0)%
                    </MudText>


                </MudCardContent>


            </MudCard>


        </MudItem>


    </MudGrid>

<MudPaper Class="pa-4 mb-4"
          Elevation="2"
          Style="border-radius:15px">

<MudText Typo="Typo.h6">
    Upcoming Class ⏰
</MudText>


@if(DashboardData?.TodayClasses
    .Any(x => x.Status == ScheduledClassStatus.Scheduled) == true)
{

var next =
DashboardData.TodayClasses
.First(x => x.Status == ScheduledClassStatus.Scheduled);


<MudText Class="mt-2">
    @next.StudentName
    -
    @next.StartTime.ToString("hh:mm tt")
</MudText>

}
else
{

<MudText>
    No upcoming classes
</MudText>

}

</MudPaper>

    <MudText Typo="Typo.h5"
         Class="mt-6 mb-4">
    Today's Classes 📚
</MudText>


<MudGrid>

@foreach(var item in DashboardData?.TodayClasses ?? new List<TodayClassResponse>())
{

<MudItem xs="12" md="6">

<MudCard Elevation="3"
         Style="border-radius:18px">

<MudCardContent>


<MudText Typo="Typo.h5">
    @item.StudentName
</MudText>


<MudText Class="mt-2">
    📚 @item.CourseName
</MudText>


<MudText>
    🕒 
    @item.StartTime.ToString("HH:mm")
    -
    @item.EndTime.ToString("HH:mm")
</MudText>



<MudChip T="string"
         Class="mt-3"
         Color="@GetStatusColor(item.Status)">

    @item.Status

</MudChip>



<MudDivider Class="my-3"/>



@if(item.Status == ScheduledClassStatus.Scheduled)
{
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               FullWidth="true"
               OnClick="@(() => StartClass(item.ScheduledClassId))">

        ▶ Start Class

    </MudButton>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Error"
               FullWidth="true"
               Class="mt-2"
               OnClick="@(() => MarkStudentAbsent(item))">

        ❌ Student Absent

    </MudButton>
}
else if(item.Status == ScheduledClassStatus.Started)
{

<MudButton Variant="Variant.Filled"
           Color="Color.Success"
           FullWidth="true"
           OnClick="@(() => OpenCompleteDialog(item))">

✅ Complete Class

</MudButton>

}
else if(item.Status == ScheduledClassStatus.Completed)
{
    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               FullWidth="true"
               OnClick="@(() => ViewReport(item))">

        📄 View Report

    </MudButton>
}
else if(item.Status == ScheduledClassStatus.Missed)
{
    <MudButton Color="Color.Dark"
               Variant="Variant.Filled"
               FullWidth="true"
               Disabled="true">

        Student Missed Class

    </MudButton>
}
else
{
    <MudButton Color="Color.Default"
               Variant="Variant.Outlined"
               FullWidth="true"
               Disabled="true">

        @item.Status

    </MudButton>
}


</MudCardContent>

</MudCard>


</MudItem>

}

</MudGrid>



    <MudText Typo="Typo.h5"
             Class="mt-8">

        Quick Actions

    </MudText>



    <MudGrid Class="mt-3">


        <MudItem xs="12"
                 sm="6"
                 md="3">

            <MudButton Variant="Variant.Filled"
                       FullWidth="true"
                       Href="/teacher/students">

                My Students

            </MudButton>

        </MudItem>


        <MudItem xs="12"
                 sm="6"
                 md="3">

            <MudButton Variant="Variant.Filled"
                       FullWidth="true"
                       Href="/teacher/attendance">

                Attendance

            </MudButton>

        </MudItem>


        <MudItem xs="12"
                 sm="6"
                 md="3">

            <MudButton Variant="Variant.Filled"
                       FullWidth="true"
                       Href="/teacher/reports">

                Class Reports

            </MudButton>

        </MudItem>


        <MudItem xs="12"
                 sm="6"
                 md="3">

            <MudButton Variant="Variant.Filled"
                       FullWidth="true"
                       Href="/teacher/schedule">

                Schedule

            </MudButton>

        </MudItem>


    </MudGrid>


</MudContainer>
@code
{
    private TeacherDashboardResponse? DashboardData;
    private bool _loaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _loaded)
            return;

        _loaded = true;

        DashboardData =
    await DashboardApi.GetDashboardAsync();

        StateHasChanged();
    }
    private Color GetStatusColor(ScheduledClassStatus status)
    {
        return status switch
        {
            ScheduledClassStatus.Scheduled => Color.Info,
            ScheduledClassStatus.Started => Color.Warning,
            ScheduledClassStatus.Completed => Color.Success,
            ScheduledClassStatus.Cancelled => Color.Error,
            ScheduledClassStatus.Missed => Color.Dark,
            _ => Color.Default
        };
    }
    private async Task StartClass(Guid id)
{
    try
    {
        await DashboardApi.StartClassAsync(id);

        Snackbar.Add(
            "Class started successfully",
            Severity.Success);

        DashboardData =
            await DashboardApi.GetDashboardAsync();

        StateHasChanged();
    }
    catch(Exception ex)
    {
        Snackbar.Add(
            ex.Message,
            Severity.Error);
    }
}
