private async Task OpenCompleteDialog(
    TodayClassResponse item)
{
    var parameters =
        new DialogParameters
        {
            ["Class"] = item
        };


    var dialog =
        await DialogService.ShowAsync
        <CompleteClassAttendanceDialog>(
            "Complete Class",
            parameters);


    var result = await dialog.Result;


    if(!result.Canceled &&
       result.Data is CompleteClassRequest request)
    {
        try
        {
            // 1. Complete scheduled class
            await DashboardApi.CompleteClassAsync(
                item.ScheduledClassId,
                new CompleteScheduledClassRequest());


            // 2. Save attendance
            await AttendanceApi.CreateAsync(
                request.Attendance);


          // 3. Save lesson progress + homework
await ClassProgressApi.CreateAsync(
    request.Progress);

// 4. Save class report
await ClassReportApi.CreateAsync(
    request.Report);

Snackbar.Add(
    "Class completed successfully.",
    Severity.Success);


            DashboardData =
                await DashboardApi.GetDashboardAsync();


            StateHasChanged();
        }
        catch(Exception ex)
        {
            Snackbar.Add(
                ex.Message,
                Severity.Error);
        }
    }
}

private async Task ViewReport(TodayClassResponse item)
{
    try
    {
        var report =
            await ClassReportApi
                .GetByScheduledClassIdAsync(
                    item.ScheduledClassId);

        if (report == null)
        {
            Snackbar.Add(
                "No class report found for this class.",
                Severity.Info);

            return;
        }

        // For now, navigate to the teacher reports page.
        // We can later make this open the exact report directly.
        NavigationManager.NavigateTo(
            "/teacher/reports");
    }
    catch (Exception ex)
    {
        Snackbar.Add(
            $"Unable to load report: {ex.Message}",
            Severity.Error);
    }
}

private async Task MarkStudentAbsent(
    TodayClassResponse item)
{
    

    try
    {
        await DashboardApi.MarkStudentAbsentAsync(
            item.ScheduledClassId);

        Snackbar.Add(
            $"{item.StudentName} marked as absent.",
            Severity.Success);

        DashboardData =
            await DashboardApi.GetDashboardAsync();

        StateHasChanged();
    }
    catch (Exception ex)
    {
        Snackbar.Add(
            $"Unable to mark student absent: {ex.Message}",
            Severity.Error);
    }
}

}