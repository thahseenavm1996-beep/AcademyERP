@page "/Teachers"

@using Microsoft.AspNetCore.Authorization

@using AcademyERP.Admin.Models
@using AcademyERP.Domain.Enums
@using AcademyERP.Admin.Services
@inject TeacherApiService TeacherApi
@using AcademyERP.Admin.Components.Pages.Teachers
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Teachers</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Teacher Management
</MudText>

<MudPaper Class="pa-4 mb-4">

    <MudStack Row="true"
          Spacing="2"
          AlignItems="AlignItems.Center"
          Class="teacher-filter-stack">

    <MudTextField T="string"
                  @bind-Value="_search"
                  Placeholder="Search Teachers..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Variant="Variant.Outlined"
                  Class="teacher-search-field" />

   <MudSelect T="Gender?"
           Label="Gender"
           Variant="Variant.Outlined"
           @bind-Value="_gender">

    <MudSelectItem T="Gender?" Value="@((Gender?)null)">
        All
    </MudSelectItem>

    <MudSelectItem T="Gender?" Value="@Gender.Male">
        Male
    </MudSelectItem>

    <MudSelectItem T="Gender?" Value="@Gender.Female">
        Female
    </MudSelectItem>

    <MudSelectItem T="Gender?" Value="@Gender.Other">
        Other
    </MudSelectItem>

</MudSelect>



    <MudSelect T="string" Label="Department" @bind-Value="_department">
    <MudSelectItem Value="@string.Empty">All</MudSelectItem>

    @foreach (var department in _departments)
    {
        <MudSelectItem Value="@department">
            @department
        </MudSelectItem>
    }
</MudSelect>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               OnClick="SearchTeachers">
        Search
    </MudButton>

    <MudButton Variant="Variant.Outlined"
               Color="Color.Default"
               OnClick="ClearFilters">
        Clear
    </MudButton>

    <MudButton Color="Color.Primary"
               Variant="Variant.Filled"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenAddTeacherDialog">
        Add Teacher
    </MudButton>

</MudStack>

        


</MudPaper>

<MudTable T="TeacherResponse" Items="_Teachers" Loading="_loading" Hover="true" Dense="true" Striped="true">

    
    <!-- <HeaderContent>

        <MudTh>Admission No</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Admission Date</MudTh>
        <MudTh>Country</MudTh>

    </HeaderContent>-->
    <HeaderContent>
        <MudTh>Employee Code</MudTh>
<MudTh>Full Name</MudTh>
<MudTh>Gender</MudTh>
<MudTh>Department</MudTh>
<MudTh>Country</MudTh>
<MudTh>Status</MudTh>

    </HeaderContent>

    <RowTemplate>

        <MudTd>@context.EmployeeCode</MudTd>
<MudTd>@context.FullName</MudTd>

<MudTd>
   @Enum.GetName(typeof(AcademyERP.Domain.Enums.Gender), context.Gender)
</MudTd>

<MudTd>
    @context.Department
</MudTd>

<MudTd>
    @context.Country
</MudTd>
        <MudTd>
            @(context.IsActive ? "Active" : "Inactive")
        </MudTd>

        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Info" Size="Size.Small"
                           Title="View teacher details" OnClick="@(() => ViewTeacher(context))" />
            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                           OnClick="@(() => EditTeacher(context))" />

            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                           OnClick="@(() => DeleteTeacher(context))" />

            <MudIconButton Icon="@Icons.Material.Filled.LockReset" Color="Color.Warning" Size="Size.Small"
                           OnClick="@(() => ResetPassword(context.Id))" />
        </MudTd>

    </RowTemplate>

</MudTable>

<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-4">

    <MudButton Variant="Variant.Outlined" Disabled="@(_page.Page <= 1)" OnClick="PreviousPage">

        Previous

    </MudButton>

    <MudText>

        Page @_page.Page of @_page.TotalPages

    </MudText>

    <MudButton Variant="Variant.Outlined" Disabled="@(_page.Page >= _page.TotalPages)" OnClick="NextPage">

        Next

    </MudButton>

</MudStack>
<MudText Class="mt-4">

    Showing @_Teachers.Count of @_page.TotalCount Teachers
    (Page @_page.Page of @_page.TotalPages)

</MudText>
@code
{
    private List<TeacherResponse> _Teachers = new();
    private TeacherData _page = new();
    private List<string> _departments = new();

    private bool _loading = true;
    private string _search = string.Empty;
   private Gender? _gender;
private string? _department;

    private readonly TeacherQueryRequest _request = new()
    {
        Page = 1,
        PageSize = 10
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadTeachersAsync();
        await LoadDepartmentsAsync();

    }
    private async Task LoadTeachersAsync()
    {
        _loading = true;
_request.Search = _search;
_request.Gender = _gender.HasValue ? (int)_gender.Value : null;
_request.Department = _department;


        var response = await TeacherApi.GetTeachersAsync(_request);

        if (response is not null)
        {
            _page = response.Data;
            _Teachers = _page.Items;
            
        }

        _loading = false;
    }
    private async Task NextPage()
    {
        if (_page.Page >= _page.TotalPages)
            return;

        _request.Page++;

        await LoadTeachersAsync();
    }

    private async Task PreviousPage()
    {
        if (_page.Page <= 1)
            return;

        _request.Page--;

        await LoadTeachersAsync();
    }

    private async Task SearchTeachers()
{
    _request.Page = 1;
    _request.Search = _search;
    _request.Gender = _gender.HasValue ? (int)_gender.Value : null;
    _request.Department = _department;

    await LoadTeachersAsync();
}
    private async Task OnSearchChanged(string value)
    {
        Console.WriteLine($"Searching for: {value}");
        _search = value;

        _request.Page = 1;
        _request.Search = _search;

        await LoadTeachersAsync();
    }
    private async Task OpenAddTeacherDialog()
    {
        Console.WriteLine("Button clicked");

        Snackbar.Add("Button clicked", Severity.Info);

        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Medium,
            FullWidth = true
        };

        var dialog = await DialogService.ShowAsync<TeacherDialog>(
            "Add Teacher",
            options);

        var result = await dialog.Result;

        if (!result.Canceled)
            await LoadTeachersAsync();
    }
    private async Task EditTeacher(TeacherResponse Teacher)
    {
        var parameters = new DialogParameters<TeacherDialog>
    {
        { x => x.Teacher, Teacher },
        { x => x.IsEdit, true }
    };

        var dialog = await DialogService.ShowAsync<TeacherDialog>(
            "Update Teacher",
            parameters);

        var result = await dialog.Result;

        if (result is not null && !result.Canceled)
        {
            await LoadTeachersAsync();
        }
    }
    private async Task ViewTeacher(TeacherResponse teacher)
    {
        await DialogService.ShowAsync<TeacherDetailsDialog>(
            "Teacher Details",
            new DialogParameters { [nameof(TeacherDetailsDialog.Teacher)] = teacher });
    }
    private async Task DeleteTeacher(TeacherResponse Teacher)
    {

        
        var success = await TeacherApi.DeleteTeacherAsync(Teacher.Id);

        if (success)
        {
            Snackbar.Add("Teacher deleted successfully.", Severity.Success);
            await LoadTeachersAsync();
        }
        else
        {
            Snackbar.Add("Failed to delete Teacher.", Severity.Error);
        }
    }

    private async Task ResetPassword(Guid id)
    {
        var parameters = new DialogParameters
        {
            { nameof(ResetPasswordTeacherDialog.TeacherId), id }
        };

        var dialog = await DialogService.ShowAsync<ResetPasswordTeacherDialog>(
            "Reset Password",
            parameters);

        var result = await dialog.Result;

        if (!result.Canceled)
        {
            Snackbar.Add("Password reset successfully.", Severity.Success);
        }
    }

    private async Task ClearFilters()
{
    _search = string.Empty;
    _gender = null;
    _department = string.Empty;

    _request.Page = 1;
    _request.Search = null;
    _request.Gender = null;
    _request.Department = null;

    await LoadTeachersAsync();
}

private async Task LoadDepartmentsAsync()
{
    var result = await TeacherApi.GetTeachersAsync(new TeacherQueryRequest
    {
        Page = 1,
        PageSize = 1000
    });

   _departments = result.Data.Items
        .Select(x => x.Department)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(x => x)
        .ToList();
}

}
